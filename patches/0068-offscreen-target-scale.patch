diff --git a/src/d3d/d3d8_device.c b/src/d3d/d3d8_device.c
index 71b9b66..6aadd32 100644
--- a/src/d3d/d3d8_device.c
+++ b/src/d3d/d3d8_device.c
@@ -376,6 +376,143 @@ BOOL d3d8_scene_target_size(UINT w, UINT h, UINT *host_w, UINT *host_h)
     return TRUE;
 }
 
+/* Offscreen colour targets drawn at a multiple of the title's size
+ * (xbox_D3D8SetOffscreenScale): a reflection or a glow the console drew
+ * small, and the host can afford to draw sharper. Only the sizes a title
+ * names, so a target the title reads back, copies by the pixel or blurs
+ * with texel-sized steps keeps its own size unless the title asks.
+ * RECOMP_D3D8_RT_SCALE overrides what the title said, for tests:
+ * "<scale>" for the title's sizes, "<scale>@WxH,WxH" for these, "1" none. */
+#define OFFSCREEN_SIZES 8
+static UINT g_off_scale[OFFSCREEN_SIZES], g_off_w[OFFSCREEN_SIZES], g_off_h[OFFSCREEN_SIZES];
+static int  g_off_n;
+static int  g_off_env = -1;                 /* -1 not read, 0 none, 1 env decides the scale,
+                                             * 2 also the sizes, 3 malformed: nothing scaled */
+static UINT g_off_env_scale = 1;
+
+/* A decimal number of 1 to 8192 at *p, moving *p past it; 0 if there is none. */
+static UINT offscreen_number(const char **p)
+{
+    char *end;
+    unsigned long v;
+
+    if (**p < '0' || **p > '9')
+        return 0;
+    v = strtoul(*p, &end, 10);
+    *p = end;
+    return v >= 1 && v <= 8192 ? (UINT)v : 0;
+}
+
+static void offscreen_env(void)
+{
+    const char *e, *p;
+    UINT scale, w[OFFSCREEN_SIZES], h[OFFSCREEN_SIZES];
+    int n = 0, i;
+
+    if (g_off_env >= 0)
+        return;
+    g_off_env = 0;
+    e = getenv("RECOMP_D3D8_RT_SCALE");
+    if (!e || !e[0])
+        return;
+    /* "<scale>" or "<scale>@WxH,WxH": anything else is refused whole, so a
+     * typo never scales targets it did not mean to. */
+    p = e;
+    scale = offscreen_number(&p);
+    if (!scale || scale > 8)
+        goto bad;
+    if (*p == '@') {
+        do {
+            if (n == OFFSCREEN_SIZES)
+                goto bad;
+            p++;
+            w[n] = offscreen_number(&p);
+            if (!w[n] || *p != 'x')
+                goto bad;
+            p++;
+            h[n] = offscreen_number(&p);
+            if (!h[n])
+                goto bad;
+            n++;
+        } while (*p == ',');
+    }
+    if (*p)
+        goto bad;
+    g_off_env_scale = scale;
+    if (!n) {
+        g_off_env = 1;                      /* the title's sizes, this scale */
+        return;
+    }
+    for (i = 0; i < n; i++) {
+        g_off_w[i] = w[i];
+        g_off_h[i] = h[i];
+        g_off_scale[i] = scale;
+    }
+    g_off_n = n;
+    g_off_env = 2;                          /* the sizes are the variable's */
+    return;
+bad:
+    g_off_env = 3;                          /* malformed: nothing is drawn larger */
+    g_off_n = 0;
+    fprintf(stderr, "D3D8: RECOMP_D3D8_RT_SCALE=%s is malformed, so no render target is drawn "
+            "larger: give \"<1-8>\" or \"<1-8>@WxH,WxH\" (at most %d sizes)\n", e, OFFSCREEN_SIZES);
+}
+
+void xbox_D3D8SetOffscreenScale(UINT width, UINT height, UINT scale)
+{
+    int i;
+
+    offscreen_env();
+    if (g_off_env >= 2 || !width || !height)
+        return;
+    if (scale < 1) scale = 1;
+    if (scale > 8) scale = 8;
+    for (i = 0; i < g_off_n; i++)
+        if (g_off_w[i] == width && g_off_h[i] == height)
+            break;
+    if (i == g_off_n) {
+        if (g_off_n == OFFSCREEN_SIZES)
+            return;
+        g_off_n++;
+    }
+    g_off_w[i] = width;
+    g_off_h[i] = height;
+    g_off_scale[i] = scale;
+    fprintf(stderr, "D3D8: %ux%u render target textures drawn at %ux (title)%s\n",
+            width, height, scale, g_off_env == 1 ? "; RECOMP_D3D8_RT_SCALE overrides the scale" : "");
+}
+
+BOOL d3d8_offscreen_target_size(UINT w, UINT h, UINT *host_w, UINT *host_h)
+{
+    UINT scale = 0;
+    int i;
+
+    offscreen_env();
+    if (g_off_env == 3)
+        return FALSE;
+    for (i = 0; i < g_off_n; i++)
+        if (g_off_w[i] == w && g_off_h[i] == h) {
+            scale = g_off_env == 1 ? g_off_env_scale : g_off_scale[i];
+            break;
+        }
+    if (scale <= 1)
+        return FALSE;
+    /* Within what every D3D11 device holds. */
+    while (scale > 1 && (w * scale > 8192 || h * scale > 8192))
+        scale--;
+    if (scale <= 1)
+        return FALSE;
+    *host_w = w * scale;
+    *host_h = h * scale;
+    {
+        static int said;
+        if (said++ < 4)
+            fprintf(stderr, "D3D8: a %ux%u render target texture is drawn at %ux%u\n",
+                    w, h, *host_w, *host_h);
+    }
+    return TRUE;
+}
+
 /* xbox_D3D8KeepPresented: the frame as it reaches the swap chain. */
 static BOOL     g_keep_presented;
 static uint8_t *g_presented;
