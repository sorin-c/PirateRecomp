-/* Vibration strength, 0 to 150 percent of what the title asks for
- * (`vibration` in the settings file, RECOMP_VIBRATION; 100 by default). Above
- * 100 makes a weak rumble stronger; a motor never goes past its maximum.
+/* Vibration strength, 0 to 100 percent of what the title asks for, in steps
+ * of 10 (`vibration` in the settings file, RECOMP_VIBRATION; 100 by default).
  * -1: not read yet. */
 static volatile int g_vibration = -1;
 
+/* Into 0..100, to the nearest 10: a file from when the steps were 25 and the
+ * top was 150 still loads (25 is 30, 150 is 100). */
+static int vibration_step(int percent)
+{
+    if (percent < 0) percent = 0;
+    if (percent > 100) percent = 100;
+    return (percent + 5) / 10 * 10;
+}
+
 static int vibration_percent(void)
 {
     int v = g_vibration;
 
     if (v < 0) {
-        v = recomp_config_int("RECOMP_VIBRATION", "vibration", 100);
-        if (v < 0) v = 0;
-        if (v > 150) v = 150;
+        v = vibration_step(recomp_config_int("RECOMP_VIBRATION", "vibration", 100));
         g_vibration = v;
     }
     return v;
@@ -1290,9 +1296,7 @@ int recomp_bindings_vibration(void)
 
 void recomp_bindings_set_vibration(int percent)
 {
-    if (percent < 0) percent = 0;
-    if (percent > 150) percent = 150;
-    g_vibration = percent;
+    g_vibration = vibration_step(percent);
 }
 
 static unsigned short scale_motor(unsigned short speed, int percent)
