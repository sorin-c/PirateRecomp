diff --git a/src/kernel/xbox_memory_layout.c b/src/kernel/xbox_memory_layout.c
index b994c2e..bc64233 100644
--- a/src/kernel/xbox_memory_layout.c
+++ b/src/kernel/xbox_memory_layout.c
@@ -2351,6 +2351,19 @@ void xbox_Nv2aFlipGateSetIdle(xbox_FlipGateIdleFn fn)
     g_flip_gate_idle = fn;
 }
 
+/* When the gate opens next: the next vblank at one Swap a vblank, and at d
+ * the next vblank whose count is a multiple of d (xbox_Nv2aFlipGateRelease
+ * opens it on those only). A title held to 30 is still given the whole
+ * two-vblank wait to lend. */
+static LONGLONG flip_gate_next_release(void)
+{
+    int d = flip_gate_divisor();
+    LONG n = InterlockedCompareExchange(&g_flip_gate_vblanks, 0, 0);
+    LONG ahead = d > 1 ? d - (LONG)(n % d) : 1;
+
+    return g_flip_gate_last_vblank + g_flip_gate_period * ahead;
+}
+
 /* Lend the wait to the hook until it wants nothing more or the vblank comes.
  * TRUE if the vblank came (the gate is released). */
 static BOOL flip_gate_lend(void)
@@ -2374,7 +2387,7 @@ static BOOL flip_gate_lend(void)
         if (WaitForSingleObject(g_flip_gate_event, 0) == WAIT_OBJECT_0)
             return TRUE;
         QueryPerformanceCounter(&now);
-        want = g_flip_gate_idle(now.QuadPart, g_flip_gate_last_vblank + g_flip_gate_period);
+        want = g_flip_gate_idle(now.QuadPart, flip_gate_next_release());
         if (want <= 0)
             return FALSE;
         QueryPerformanceCounter(&now);
@@ -2479,9 +2492,9 @@ void xbox_Nv2aFlipGateArm(void)
          * recorded host calls and must not touch guest memory. */
         int guest_held = xbox_GuestLockDrop();
 
-        /* Only while one Swap a vblank is the cadence: the release is then
-         * always the next vblank, which is what the hook is told. */
-        if (!(g_flip_gate_idle && flip_gate_divisor() == 1 && flip_gate_lend()) &&
+        /* Whenever the gate releases on vblanks: the hook is told which
+         * vblank will release it (flip_gate_next_release). */
+        if (!(g_flip_gate_idle && flip_gate_divisor() >= 1 && flip_gate_lend()) &&
             WaitForSingleObject(g_flip_gate_event, 250) == WAIT_TIMEOUT && !said++) {
             fprintf(stderr, "  [NV2A] flip gate timed out: no vblank for 250 ms, "
