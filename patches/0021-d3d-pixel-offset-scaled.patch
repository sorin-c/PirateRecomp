+    hv.x         = ((FLOAT)vp->X + pixel_offset(sx)) * sx;
+    hv.y         = ((FLOAT)vp->Y + pixel_offset(sy)) * sy;
     hv.width     = (FLOAT)vp->Width * sx;
     hv.height    = (FLOAT)vp->Height * sy;
     hv.min_depth = vp->MinZ;
