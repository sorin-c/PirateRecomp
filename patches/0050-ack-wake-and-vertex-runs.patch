-    return (HRESULT)rhi_present(g_present_interval);
+    {
+        HRESULT hr;
+        LARGE_INTEGER a, b;
+        int on = frame_work_on();
+        if (on) QueryPerformanceCounter(&a);
+        hr = (HRESULT)rhi_present(g_present_interval);
+        if (on) { QueryPerformanceCounter(&b); frame_work_note(a.QuadPart, b.QuadPart); }
+        return hr;
+    }
 }
 
