+/* The ack thread's wake-up (xbox_Nv2aAckWake): set while it sleeps between
+ * idle passes, so a kick can cut the sleep short; and until when it polls
+ * for the bit the kick is about to set. */
+static HANDLE           g_ack_wake;
+static volatile LONG    g_ack_sleeping;
+static volatile int64_t g_ack_expect_ns;
+#define ACK_EXPECT_NS 200000            /* 200 us: the kick sets its bit at once */
+
+/* A push-buffer kick is coming (the HLE's CDevice_KickOff,
+ * hle_d3d8_vertex.c): the title is about to set a busy bit and spin until it
+ * clears. Asleep between idle passes, the thread used to see it a timer
+ * period later (about 1 ms here, against the 100 us asked), and the title
+ * spun all that time: 4-7% of Pirates!' game thread at sea, in battles and
+ * in the tavern. Woken now, it polls for up to ACK_EXPECT_NS and clears the
+ * bit within microseconds; after that it carries on as it always did (busy
+ * for a millisecond after a change, then idle), so it costs no more CPU than
+ * before. RECOMP_NV2A_ACK_WAKE=0 leaves kicks to the timer. */
+void xbox_Nv2aAckWake(void)
+{
+    static int on = -1;
+    if (on < 0)
+        on = xbox_EnvSwitch("RECOMP_NV2A_ACK_WAKE", 1);
+    if (!on || !g_ack_wake)
+        return;
+    g_ack_expect_ns = host_time_ns() + ACK_EXPECT_NS;
+    if (InterlockedCompareExchange(&g_ack_sleeping, 0, 0))
+        SetEvent(g_ack_wake);
+}
