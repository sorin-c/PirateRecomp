+/* RECOMP_FRAME_WORK=1, for measuring: what a frame costs the thread that
+ * draws it, apart from the present. Every five seconds, to stderr: frames,
+ * the mean frame, the mean time blocked in the present, and the frame's own
+ * work (the time from one present's return to the next present's call):
+ * mean, 99th percentile and worst. A display that refreshes slower than the
+ * PC draws makes the present block; the work is what the PC needed. */
+static int frame_work_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_FRAME_WORK");
+        on = e && *e && *e != '0';
+    }
+    return on;
+}
+
+static void frame_work_note(long long before, long long after)
+{
+    static long long last_after, window_start, freq;
+    static double work_us[8192];
+    static unsigned n;
+    static double present_sum, work_sum;
+
+    if (!freq) {
+        LARGE_INTEGER f; QueryPerformanceFrequency(&f); freq = f.QuadPart;
+        window_start = before;
+    }
+    if (last_after && n < 8192u) {
+        double w = (double)(before - last_after) * 1e6 / (double)freq;
+        work_us[n++] = w;
+        work_sum += w;
+        present_sum += (double)(after - before) * 1e6 / (double)freq;
+    }
+    last_after = after;
+    if (after - window_start >= freq * 5 && n) {
+        /* 99th percentile by partial selection: count above a threshold */
+        double worst = 0, p99 = 0, secs = (double)(after - window_start) / (double)freq;
+        unsigned i, k = n / 100u, above;
+        for (i = 0; i < n; i++) if (work_us[i] > worst) worst = work_us[i];
+        {   double lo = 0, hi = worst;
+            int it;
+            for (it = 0; it < 30; it++) {
+                double mid = (lo + hi) / 2;
+                for (above = 0, i = 0; i < n; i++) if (work_us[i] > mid) above++;
+                if (above > k) lo = mid; else hi = mid;
+            }
+            p99 = hi;
+        }
+        fprintf(stderr, "[FRAMEWORK] %u frames in %.1fs (%.1f fps): present %.2f ms, "
+                "work mean %.2f ms p99 %.2f ms worst %.2f ms\n",
+                n, secs, n / secs, present_sum / n / 1000.0, work_sum / n / 1000.0,
+                p99 / 1000.0, worst / 1000.0);
+        fflush(stderr);
+        n = 0; present_sum = work_sum = 0; window_start = after;
+    }
+}
+
