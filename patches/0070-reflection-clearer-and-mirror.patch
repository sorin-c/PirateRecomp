  * "<scale>" for the title's sizes, "<scale>@WxH,WxH" for these, "1" none. */
 #define OFFSCREEN_SIZES 8
 static UINT g_off_scale[OFFSCREEN_SIZES], g_off_w[OFFSCREEN_SIZES], g_off_h[OFFSCREEN_SIZES];
+/* xbox_D3D8SetOffscreenEffect, per size: the bump-environment matrix's
+ * scale for a stage that samples such a target, and the weight it is laid
+ * over the picture with as a mirror (0: as the title draws it). */
+static float g_off_bump[OFFSCREEN_SIZES], g_off_mirror[OFFSCREEN_SIZES];
 static int  g_off_n;
 static int  g_off_env = -1;                 /* -1 not read, 0 none, 1 env decides the scale,
                                              * 2 also the sizes, 3 malformed: nothing scaled */
@@ -482,6 +486,69 @@ void xbox_D3D8SetOffscreenScale(UINT width, UINT height, UINT scale)
             width, height, scale, g_off_env == 1 ? "; RECOMP_D3D8_RT_SCALE overrides the scale" : "");
 }
 
+void xbox_D3D8SetOffscreenEffect(UINT width, UINT height, float bump_scale, float mirror)
+{
+    int i;
+
+    offscreen_env();
+    if (!width || !height)
+        return;
+    if (bump_scale < 0.01f) bump_scale = 0.01f;
+    if (bump_scale > 1.0f) bump_scale = 1.0f;
+    if (mirror < 0.0f) mirror = 0.0f;
+    if (mirror > 1.0f) mirror = 1.0f;
+    for (i = 0; i < g_off_n; i++)
+        if (g_off_w[i] == width && g_off_h[i] == height)
+            break;
+    if (i == g_off_n) {
+        if (g_off_n == OFFSCREEN_SIZES)
+            return;
+        g_off_n++;
+        g_off_w[i] = width;
+        g_off_h[i] = height;
+        g_off_scale[i] = 1;
+    }
+    g_off_bump[i] = bump_scale;
+    g_off_mirror[i] = mirror;
+    fprintf(stderr, "D3D8: %ux%u render target textures: bump x%.2f, mirror %.2f (title)\n",
+            width, height, (double)bump_scale, (double)mirror);
+}
+
+/* The effect a title asked for (xbox_D3D8SetOffscreenEffect) on a render
+ * target texture it samples: FALSE for any other texture. */
+BOOL d3d8_offscreen_effect(IDirect3DBaseTexture8 *texture, float *bump_scale, float *mirror)
+{
+    D3D8TextureInfo info;
+    int i;
+
+    if (!texture || !g_off_n || !d3d8_texture_info(texture, &info) ||
+        !(info.usage & D3DUSAGE_RENDERTARGET))
+        return FALSE;
+    for (i = 0; i < g_off_n; i++)
+        if (g_off_w[i] == info.width && g_off_h[i] == info.height) {
+            if (g_off_bump[i] == 0.0f && g_off_mirror[i] == 0.0f)
+                return FALSE;           /* never set: no effect */
+            *bump_scale = g_off_bump[i];
+            *mirror = g_off_mirror[i];
+            return TRUE;
+        }
+    return FALSE;
+}
+
+/* Whether the bound target is a render target texture of a size the title
+ * set an effect for: a pass building its reflection, not one showing it. */
+BOOL d3d8_target_is_offscreen_effect(void)
+{
+    int i;
+
+    if (!g_cur_rt || !g_off_n)
+        return FALSE;
+    for (i = 0; i < g_off_n; i++)
+        if (g_off_w[i] == g_cur_rt->width && g_off_h[i] == g_cur_rt->height)
+            return g_off_bump[i] != 0.0f || g_off_mirror[i] != 0.0f;
+    return FALSE;
+}
