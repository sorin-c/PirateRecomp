+/* The resolution: a height or native, its label at each shape, and an
+ * older file's resolution_scale read as rows. */
+static void test_resolution(void)
+{
+    char label[48];
+    const char *rt = "test_config_res.conf";
+    RecompSettings s;
+
+    check_int(recomp_resolution_parse("native"), RECOMP_RESOLUTION_NATIVE, "native");
+    check_int(recomp_resolution_parse("1080"), 1080, "rows");
+    check_int(recomp_resolution_parse("1440p"), 1440, "rows with a p");
+    check_int(recomp_resolution_parse("100"), 480, "too few rows: the console's");
+    check_int(recomp_resolution_parse("99999"), 4320, "too many rows: the most");
+    check_int(recomp_resolution_parse("big"), -1, "not a resolution");
+    check_int(recomp_resolution_parse("-1"), -1, "a negative height is not a resolution");
+
+    recomp_set_native_size(2560, 1440);
+    check_int(recomp_resolution_rows_for(RECOMP_RESOLUTION_NATIVE, 1), 1440, "native 16:9 on 2560x1440");
+    check_int(recomp_resolution_rows_for(RECOMP_RESOLUTION_NATIVE, 0), 1440, "native 4:3 on 2560x1440");
+    recomp_set_native_size(1920, 1200);
+    check_int(recomp_resolution_rows_for(RECOMP_RESOLUTION_NATIVE, 1), 1080, "native 16:9 on 16:10");
+    check_int(recomp_resolution_rows_for(RECOMP_RESOLUTION_NATIVE, 0), 1200, "native 4:3 on 16:10");
+    recomp_set_native_size(2560, 1440);
+
+    recomp_resolution_label(1080, 1, label, sizeof label);
+    check_str(label, "1920x1080", "1080 in widescreen");
+    recomp_resolution_label(1080, 0, label, sizeof label);
+    check_str(label, "1440x1080", "1080 at 4:3");
+    recomp_resolution_label(2160, 1, label, sizeof label);
+    check_str(label, "3840x2160", "4K");
+    recomp_resolution_label(480, 1, label, sizeof label);
+    check_str(label, "Console (854x480)", "the console's, wide");
+    recomp_resolution_label(RECOMP_RESOLUTION_NATIVE, 1, label, sizeof label);
+    check_str(label, "Native (2560x1440)", "native, wide");
+
+    write_file(rt, "resolution_scale = 3\n");
+    check(recomp_settings_read(rt, &s) != 0, "older file read");
+    check_int(s.resolution, 1440, "older file: 3x is 1440 rows");
+    write_file(rt, "resolution_scale = 1\n");
+    recomp_settings_read(rt, &s);
+    check_int(s.resolution, RECOMP_RESOLUTION_NATIVE, "older file: 1x, the old default, is native");
+    write_file(rt, "resolution_scale = 3\nresolution = 2160\n");
+    recomp_settings_read(rt, &s);
+    check_int(s.resolution, 2160, "resolution wins over resolution_scale");
+    write_file(rt, "widescreen = 0\n");
+    recomp_settings_read(rt, &s);
+    check_int(s.resolution, RECOMP_RESOLUTION_NATIVE, "no line: native");
+    remove(rt);
+}
