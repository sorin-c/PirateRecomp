+/* ---------------------------------------------------------- resolution */
+
+const int recomp_resolution_choices[RECOMP_RESOLUTION_CHOICES] = {
+    RECOMP_RESOLUTION_NATIVE, 480, 720, 1080, 1440, 2160, 2880, 4320
+};
+
+int recomp_resolution_parse(const char *v)
+{
+    char *end = NULL;
+    long n;
+
+    if (!v)
+        return -1;
+    while (*v == ' ' || *v == '\t')
+        v++;
+    if (ieq(v, "native") || ieq(v, "auto"))
+        return RECOMP_RESOLUTION_NATIVE;
+    n = strtol(v, &end, 10);
+    if (end == v)
+        return -1;
+    /* "1080p" is 1080 too. */
+    if (*end == 'p' || *end == 'P')
+        end++;
+    while (*end == ' ' || *end == '\t')
+        end++;
+    if (*end || n < 0)
+        return -1;
+    if (n == 0)
+        return RECOMP_RESOLUTION_NATIVE;
+    return n < RECOMP_RESOLUTION_MIN_ROWS ? RECOMP_RESOLUTION_MIN_ROWS
+         : n > RECOMP_RESOLUTION_MAX_ROWS ? RECOMP_RESOLUTION_MAX_ROWS : (int)n;
+}
+
+static int g_native_w, g_native_h;
+
+void recomp_set_native_size(int w, int h)
+{
+    if (w > 0 && h > 0) {
+        g_native_w = w;
+        g_native_h = h;
+    }
+}
+
+void recomp_native_size(int *w, int *h)
+{
+#if defined(_WIN32)
+    if (!g_native_w) {
+        /* The mode the primary display is in, in its own pixels: unlike
+         * GetSystemMetrics, not shrunk by the desktop's scaling for a
+         * program that has not said it is DPI aware. The game's window
+         * opens on the primary display. */
+        DEVMODEW dm;
+
+        memset(&dm, 0, sizeof dm);
+        dm.dmSize = sizeof dm;
+        if (EnumDisplaySettingsW(NULL, ENUM_CURRENT_SETTINGS, &dm) &&
+            dm.dmPelsWidth > 0 && dm.dmPelsHeight > 0)
+            recomp_set_native_size((int)dm.dmPelsWidth, (int)dm.dmPelsHeight);
+    }
+#endif
+    if (w) *w = g_native_w;
+    if (h) *h = g_native_h;
+}
+
+int recomp_resolution_rows_for(int resolution, int widescreen)
+{
+    int rows = resolution;
+
+    if (resolution == RECOMP_RESOLUTION_NATIVE) {
+        int w, h;
+
+        recomp_native_size(&w, &h);
+        if (w > 0 && h > 0) {
+            /* The tallest picture of this shape the display holds. */
+            long long fit = widescreen ? (long long)w * 9 / 16 : (long long)w * 3 / 4;
+
+            rows = fit < h ? (int)fit : h;
+        } else {
+            rows = 1080;
+        }
+    }
+    return clamp_int(rows, RECOMP_RESOLUTION_MIN_ROWS, RECOMP_RESOLUTION_MAX_ROWS);
+}
+
+void recomp_resolution_label(int resolution, int widescreen, char *out, size_t n)
+{
+    int rows = recomp_resolution_rows_for(resolution, widescreen);
+    /* Rounded as the window's width is (recomp_window_size): 480 rows at
+     * 16:9 are 854 wide. */
+    int cols = widescreen ? (int)(((long long)rows * 16 + 8) / 9) : rows * 4 / 3;
+
+    if (!out || !n)
+        return;
+    if (resolution == RECOMP_RESOLUTION_NATIVE)
+        snprintf(out, n, "Native (%dx%d)", cols, rows);
+    else if (rows == RECOMP_RESOLUTION_MIN_ROWS)
+        snprintf(out, n, "Console (%dx%d)", cols, rows);
+    else
+        snprintf(out, n, "%dx%d", cols, rows);
+}
+
+int recomp_resolution_rows(void)
+{
+    int wide = recomp_config_bool("RECOMP_WIDESCREEN", "widescreen",
+                                  recomp_title_default_widescreen());
+    const char *v = getenv("RECOMP_RESOLUTION");
+    int r;
+
+    if (v && *v && (r = recomp_resolution_parse(v)) >= 0)
+        return recomp_resolution_rows_for(r, wide);
+    v = getenv("RECOMP_RES_SCALE");
+    if (v && *v) {
+        /* The whole value, as d3d8_display_policy checks it (and warns
+         * about): "2junk" is no scale at all. */
+        char *end = NULL;
+        long n = strtol(v, &end, 10);
+
+        if (end != v && !*end && n >= 1 && n <= 8)
+            return RECOMP_RESOLUTION_MIN_ROWS * (int)n;
+    }
+    v = recomp_config_lookup(NULL, "resolution");
+    if (v && *v && (r = recomp_resolution_parse(v)) >= 0)
+        return recomp_resolution_rows_for(r, wide);
+    v = recomp_config_lookup(NULL, "resolution_scale");
+    if (v && *v && atoi(v) > 1)
+        return RECOMP_RESOLUTION_MIN_ROWS * clamp_int(atoi(v), 1, 8);
+    return recomp_resolution_rows_for(RECOMP_RESOLUTION_NATIVE, wide);
+}
