+/* ---------------------------------------------------------- resolution */
+
+/* How tall the picture is rendered: `resolution` in the settings file
+ * (RECOMP_RESOLUTION), as rows, or native, the display's own. The scene
+ * is drawn at that many rows and as wide as the guest's frame is at that
+ * height, then filtered onto the window, so a picture taller than the
+ * window is supersampled and one at the display's height is drawn pixel
+ * for pixel when fullscreen. */
+#define RECOMP_RESOLUTION_NATIVE   0
+#define RECOMP_RESOLUTION_MIN_ROWS 480
+#define RECOMP_RESOLUTION_MAX_ROWS 4320
+/* What the launcher and the in-game menu offer, native first. */
+#define RECOMP_RESOLUTION_CHOICES  8
+extern const int recomp_resolution_choices[RECOMP_RESOLUTION_CHOICES];
+
+/* "native" (or "auto", or 0) is RECOMP_RESOLUTION_NATIVE; a number is rows,
+ * kept inside MIN..MAX. -1 for anything else. */
+int  recomp_resolution_parse(const char *v);
+/* The primary display's size in pixels, as the display reports it (not as
+ * Windows scales it for a program that is not DPI aware). 0 x 0 when
+ * nothing has said: on Windows it is asked; elsewhere a host that knows
+ * says so with recomp_set_native_size. */
+void recomp_native_size(int *w, int *h);
+void recomp_set_native_size(int w, int h);
+/* The rows `resolution` renders at for a picture shown at 16:9
+ * (widescreen) or 4:3: native is the tallest picture of that shape that
+ * fits the display (1440 on 2560x1440, 1440 on 3440x1440, 1350 on
+ * 1800x1350...), 1080 when the display is not known. */
+int  recomp_resolution_rows_for(int resolution, int widescreen);
+/* What the launcher and menu show for it: "1920x1080", "Native
+ * (2560x1440)", "Console (854x480)". */
+void recomp_resolution_label(int resolution, int widescreen, char *out, size_t n);
+/* The runtime's answer, read once by the renderer: RECOMP_RESOLUTION, else
+ * RECOMP_RES_SCALE (480 x it), else the file's `resolution`, else an older
+ * file's resolution_scale above 1, else native. */
+int  recomp_resolution_rows(void);
