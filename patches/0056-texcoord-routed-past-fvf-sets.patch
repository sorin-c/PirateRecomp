+        uint32_t base = base_all + (uint32_t)(s * STAGE_SIZE * 4);
 
         for (i = 0; i < sizeof g_ts_map / sizeof g_ts_map[0]; i++) {
             uint32_t x = g_ts_map[i].xbox;
@@ -1081,7 +1110,7 @@ void hle_d3d8_shadow_apply_states(IDirect3DDevice8 *dev)
              * carries the draw's kind in bit 31. */
