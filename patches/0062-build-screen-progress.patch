+/* ---- a title's own look, for the self-building release's first run ----
+ *
+ * THEME_LOOK_SEA is brass on a dark sea blue, the look of Sid Meier's
+ * Pirates!' in-game menu (a release asks for it with "look": "sea" in its
+ * recipe). While it is set, theme_background, theme_panel and theme_bar
+ * draw in it, and text drawn in THEME_GREEN, THEME_TEXT and THEME_TEXT_DIM
+ * comes out brass, cream and a grey-blue, so a screen written for the
+ * dashboard look takes the sea look without being written twice. */
+#define THEME_LOOK_DASHBOARD 0
+#define THEME_LOOK_SEA       1
+void theme_set_look(int look);
+int  theme_look(void);
+
+/* The sea look's own colours. */
+#define THEME_BRASS        RGB(0xD9, 0xB2, 0x6A)
+#define THEME_BRASS_LIGHT  RGB(0xE6, 0xC2, 0x7E)
+#define THEME_BRASS_MID    RGB(0xB8, 0x91, 0x4C)
+#define THEME_BRASS_DARK   RGB(0x8C, 0x6C, 0x34)
+#define THEME_CREAM        RGB(0xF3, 0xEB, 0xD8)
+#define THEME_MIST         RGB(0xC9, 0xD3, 0xDC)
+#define THEME_SLATE        RGB(0x9A, 0xAC, 0xBC)
+#define THEME_ROUTE        RGB(0x3E, 0x5A, 0x72)
+#define THEME_NAVY         RGB(0x0E, 0x22, 0x36)
+
+/* Text after this in a serif face (Georgia on Windows, the desktop's
+ * serif on Linux; macOS keeps its system face), until it is set back. */
+void theme_set_serif(int on);
+
+/* Shapes, in window units, antialiased. `alpha` 0..1. */
+void theme_fill(ThemeRect r, double radius, COLORREF colour, double alpha);
+void theme_fill_vgrad(ThemeRect r, double radius, COLORREF top, COLORREF bottom);
+void theme_disc(double cx, double cy, double radius, COLORREF colour, double alpha);
+void theme_diamond(double cx, double cy, double radius, COLORREF colour);
+/* A one-unit line, faded in from the left (fade < 0), out to the right
+ * (fade > 0) or solid (0); and the same dashed. */
+void theme_hline(int x0, int x1, int y, COLORREF colour, double alpha, int fade);
+void theme_hdash(int x0, int x1, int y, int thick, COLORREF colour);
+/* A band of twisted rope across `r`: the sea look's trim. */
+void theme_rope(ThemeRect r);
+
