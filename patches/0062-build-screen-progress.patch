+/* "1:05": minutes and seconds. */
+static void fmt_clock(char *out, size_t n, uint64_t ms)
+{
+    unsigned s = (unsigned)(ms / 1000);
+
+    snprintf(out, n, "%u:%02u", s / 60, s % 60);
+}
+
+static void eta_text(char *out, size_t n)
+{
+    uint64_t now = lhost_ticks();
+    unsigned left;
+
+    if (!g_eta_have) {
+        snprintf(out, n, "Working out the time left");
+        return;
+    }
+    left = g_eta_end > now ? (unsigned)((g_eta_end - now + 500) / 1000) : 0;
+    if (left >= 90)
+        snprintf(out, n, "About %u min left", (left + 30) / 60);
+    else if (left >= 45)
+        snprintf(out, n, "About a minute left");
+    else if (left >= 10)
+        snprintf(out, n, "Less than a minute left");
+    else
+        snprintf(out, n, "Almost done");
+}
