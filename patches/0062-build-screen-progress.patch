+/* The steps as ports along a sea route: done, the one under way, to come. */
+static void sea_route(int top)
+{
+    const int x0 = 72, w = g_cw - 144, cy = top + 10;
+    uint64_t now = lhost_ticks();
+    char t[32];
+    int i, step = g_build_step < 0 ? 0 : g_build_step;
+    double col = w / (double)BUILD_STEPS;
+    int first = (int)(x0 + col / 2), last = (int)(x0 + col * (BUILD_STEPS - 0.5));
+    int here = (int)(x0 + col * ((step < BUILD_STEPS ? step : BUILD_STEPS - 1) + 0.5));
+
+    theme_hdash(here, last, cy, 2, THEME_ROUTE);
+    if (here > first) {
+        ThemeRect sailed = { first, cy, here - first, 2 };
+
+        theme_fill(sailed, 0, THEME_BRASS_MID, 1.0);
+    }
+    for (i = 0; i < BUILD_STEPS; i++) {
+        double cx = x0 + col * (i + 0.5);
+        ThemeRect r;
+        int done = i < step, now_on = i == step;
+
+        if (done) {
+            theme_disc(cx, cy + 1, 8.0, THEME_BRASS_LIGHT, 1.0);
+            theme_disc(cx, cy + 1, 6.0, THEME_BRASS_MID, 1.0);
+        } else if (now_on) {
+            theme_disc(cx, cy + 1, 10.5, THEME_BRASS_LIGHT, 1.0);
+            theme_disc(cx, cy + 1, 8.0, THEME_NAVY, 1.0);
+            theme_disc(cx, cy + 1, 3.0 + 1.0 * sin(g_pulse * 6.2831853 * 3),
+                       THEME_BRASS_LIGHT, 1.0);
+        } else {
+            theme_disc(cx, cy + 1, 8.0, THEME_ROUTE, 1.0);
+            theme_disc(cx, cy + 1, 6.5, THEME_NAVY, 1.0);
+        }
+        r.x = (int)(x0 + col * i); r.w = (int)col; r.y = cy + 18; r.h = 20;
+        theme_text(r, k_step_short[i], 11, now_on ? 700 : 400,
+                   done ? THEME_BRASS : now_on ? THEME_CREAM : THEME_SLATE, THEME_CENTRE);
+        r.y += 20;
+        if (done) {
+            fmt_clock(t, sizeof t, g_step_ms[i]);
+            theme_text(r, t, 10, 400, THEME_SLATE, THEME_CENTRE);
+        } else if (now_on) {
+            fmt_clock(t, sizeof t, now - g_step_started[i]);
+            theme_text(r, t, 10, 700, THEME_CREAM, THEME_CENTRE);
+        }
+    }
+}
