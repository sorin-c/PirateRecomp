+/* A click on the footer's links; 1 when it was one. */
+static int sea_footer_click(int mx, int my)
+{
+    char path[LAUNCHER_PATH + 32];
+    int i;
+
+    for (i = 0; i < LINK_COUNT; i++) {
+        if (!sea_link_shown(i) || !in_rect(sea_link_rect(i), mx, my))
+            continue;
+        if (i == LINK_LOG) {
+#ifdef _WIN32
+            snprintf(path, sizeof path, "%s\\build.log", g_user_dir);
+#else
+            snprintf(path, sizeof path, "%s/build.log", g_user_dir);
+#endif
+            lhost_open(path);
+        } else if (i == LINK_FOLDER) {
+            lhost_open(g_user_dir);
+        } else {
+            lhost_open(g_home_url);
+        }
+        return 1;
+    }
+    return 0;
+}
