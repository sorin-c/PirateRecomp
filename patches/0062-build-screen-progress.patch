+/* ------------------------------------------------------ the sea look */
+
+/* Pixel bounds of a window-unit box grown by `pad`, clipped to the buffer. */
+static void px_bounds(double x, double y, double w, double h, double pad,
+                      int *x0, int *y0, int *x1, int *y1)
+{
+    const double s = theme_scale;
+
+    *x0 = (int)floor((x - pad) * s);
+    *y0 = (int)floor((y - pad) * s);
+    *x1 = (int)ceil((x + w + pad) * s);
+    *y1 = (int)ceil((y + h + pad) * s);
+    if (*x0 < 0) *x0 = 0;
+    if (*y0 < 0) *y0 = 0;
+    if (*x1 > theme_w) *x1 = theme_w;
+    if (*y1 > theme_h) *y1 = theme_h;
+}
+
+static void fill_rrect(ThemeRect r, double radius, COLORREF top, COLORREF bottom,
+                       double alpha)
+{
+    const double s = theme_scale;
+    int x0, y0, x1, y1, x, y;
+
+    if (!theme_px || r.w <= 0 || r.h <= 0)
+        return;
+    if (radius > r.w / 2.0) radius = r.w / 2.0;
+    if (radius > r.h / 2.0) radius = r.h / 2.0;
+    px_bounds(r.x, r.y, r.w, r.h, 1, &x0, &y0, &x1, &y1);
+    for (y = y0; y < y1; y++) {
+        double t = clamp01(((y + 0.5) / s - r.y) / r.h);
+        int cr = (int)(CR(top) + (CR(bottom) - CR(top)) * t);
+        int cg = (int)(CG(top) + (CG(bottom) - CG(top)) * t);
+        int cb = (int)(CB(top) + (CB(bottom) - CB(top)) * t);
+
+        for (x = x0; x < x1; x++) {
+            double d = rrect_distance((x + 0.5) / s, (y + 0.5) / s, r, radius);
+            double edge = clamp01(0.5 - d * s);
+
+            if (edge > 0)
+                blend(x, y, cr, cg, cb, alpha * edge);
+        }
+    }
+}
+
+void theme_fill(ThemeRect r, double radius, COLORREF colour, double alpha)
+{
+    fill_rrect(r, radius, colour, colour, alpha);
+}
+
+void theme_fill_vgrad(ThemeRect r, double radius, COLORREF top, COLORREF bottom)
+{
+    fill_rrect(r, radius, top, bottom, 1.0);
+}
+
+void theme_disc(double cx, double cy, double radius, COLORREF colour, double alpha)
+{
+    const double s = theme_scale;
+    int x0, y0, x1, y1, x, y;
+
+    if (!theme_px)
+        return;
+    px_bounds(cx - radius, cy - radius, radius * 2, radius * 2, 1, &x0, &y0, &x1, &y1);
+    for (y = y0; y < y1; y++)
+        for (x = x0; x < x1; x++) {
+            double dx = (x + 0.5) / s - cx, dy = (y + 0.5) / s - cy;
+            double edge = clamp01(0.5 - (sqrt(dx * dx + dy * dy) - radius) * s);
+
+            if (edge > 0)
+                blend(x, y, CR(colour), CG(colour), CB(colour), alpha * edge);
+        }
+}
+
+void theme_diamond(double cx, double cy, double radius, COLORREF colour)
+{
+    const double s = theme_scale;
+    int x0, y0, x1, y1, x, y;
+
+    if (!theme_px)
+        return;
+    px_bounds(cx - radius, cy - radius, radius * 2, radius * 2, 1, &x0, &y0, &x1, &y1);
+    for (y = y0; y < y1; y++)
+        for (x = x0; x < x1; x++) {
+            double d = fabs((x + 0.5) / s - cx) + fabs((y + 0.5) / s - cy) - radius;
+            double edge = clamp01(0.5 - d * s * 0.7071);
+
+            if (edge > 0)
+                blend(x, y, CR(colour), CG(colour), CB(colour), edge);
+        }
+}
+
+void theme_hline(int x0, int x1, int y, COLORREF colour, double alpha, int fade)
+{
+    const double s = theme_scale;
+    int px0 = (int)floor(x0 * s), px1 = (int)ceil(x1 * s);
+    int py0 = (int)floor(y * s), py1 = (int)floor((y + 1) * s);
+    int px, py;
+
+    if (!theme_px || x1 <= x0)
+        return;
+    if (py1 <= py0) py1 = py0 + 1;
+    for (px = px0; px < px1; px++) {
+        double t = clamp01(((px + 0.5) / s - x0) / (double)(x1 - x0));
+        double a = alpha * (fade < 0 ? t : fade > 0 ? 1.0 - t : 1.0);
+
+        for (py = py0; py < py1; py++)
+            blend(px, py, CR(colour), CG(colour), CB(colour), a);
+    }
+}
+
+void theme_hdash(int x0, int x1, int y, int thick, COLORREF colour)
+{
+    int x;
+
+    for (x = x0; x < x1; x += 10) {
+        ThemeRect d = { x, y, x + 6 <= x1 ? 6 : x1 - x, thick };
+
+        theme_fill(d, 0, colour, 1.0);
+    }
+}
+
+void theme_rope(ThemeRect r)
+{
+    const double s = theme_scale;
+    int x0, y0, x1, y1, x, y;
+
+    if (!theme_px)
+        return;
+    px_bounds(r.x, r.y, r.w, r.h, 0, &x0, &y0, &x1, &y1);
+    for (y = y0; y < y1; y++) {
+        double v = ((y + 0.5) / s - r.y) / r.h;         /* 0 top .. 1 bottom */
+        /* Rounder in the middle, as a rope is. */
+        double shade = 0.75 + 0.45 * sin(v * 3.14159265);
+
+        for (x = x0; x < x1; x++) {
+            /* Strands lie at a slant: light where a strand's crown is,
+             * dark in the lay between two strands. */
+            double u = (x + 0.5) / s + ((y + 0.5) / s - r.y) * 0.55;
+            double w = u / 7.0 - floor(u / 7.0);
+            double k = (w < 0.62 ? sin(w / 0.62 * 3.14159265) : 0.0) * shade;
+            int cr = (int)(0x5A + (0xE6 - 0x5A) * clamp01(k));
+            int cg = (int)(0x44 + (0xC2 - 0x44) * clamp01(k));
+            int cb = (int)(0x1E + (0x7E - 0x1E) * clamp01(k));
+
+            blend(x, y, cr, cg, cb, 1.0);
+        }
+    }
+    theme_hline(r.x, r.x + r.w, r.y - 1, THEME_BRASS_LIGHT, 0.6, 0);
+    theme_hline(r.x, r.x + r.w, r.y + r.h, RGB(0x3A, 0x2C, 0x12), 0.9, 0);
+}
