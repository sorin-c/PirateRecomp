+static void sea_done(void)
+{
+    ThemeRect r, b;
+    char text[LAUNCHER_PATH + 400], t[64];
+    unsigned secs = (unsigned)((g_build_ms + 500) / 1000);
+
+    theme_set_serif(1);
+    r.x = 60; r.w = g_cw - 120; r.y = 168; r.h = 22;
+    theme_text(r, g_rel_relinking ? "FILES FOUND" : "ALL 6 STEPS DONE", 12, 400,
+               THEME_BRASS, THEME_CENTRE);
+    r.y = 194; r.h = 40;
+    text_shadowed(r, "The game is ready", 21, 700, THEME_CREAM, THEME_CENTRE);
+    theme_set_serif(0);
+    sea_ornament(254);
+
+    b.x = 72; b.y = 280; b.w = g_cw - 144; b.h = 30;
+    theme_bar(b, 1.0, -1.0);
+    if (g_rel_relinking)
+        snprintf(t, sizeof t, "Linked again");
+    else if (secs >= 60)
+        snprintf(t, sizeof t, "Built in %u min %u s", secs / 60, secs % 60);
+    else
+        snprintf(t, sizeof t, "Built in %u s", secs);
+    theme_text(b, t, 12, 700, RGB(0x1A, 0x12, 0x08), THEME_CENTRE);
+
+    if (g_rel_relinking)
+        snprintf(text, sizeof text, "%s is linked to its files at %s again. Nothing was "
+                 "rebuilt, and your saves are where they were.", g_title_name, g_source);
+    else
+        snprintf(text, sizeof text, "%s was built from your copy. Next time, the launcher "
+                 "opens straight to the settings and Play. Your saves stay where they are.",
+                 g_title_name);
+    r.x = 150; r.w = g_cw - 300; r.y = 370; r.h = 100;
+    theme_text_wrapped(r, text, 13, THEME_MIST);
+
+    b = sea_ok_rect();
+    sea_button(b, "SET SAIL", 1);
+    r.x = b.x; r.w = b.w; r.y = b.y + b.h + 8; r.h = 20;
+    theme_text(r, g_pad_seen ? "A  to continue" : "Enter  to continue", 11, 400, THEME_SLATE,
+               THEME_CENTRE);
+}
