+/* HDR output. On, and with the display in HDR (Windows' "Use HDR" on for
+ * the screen the window is on), the swap chain becomes scRGB (FP16, linear,
+ * BT.709 primaries) and the picture -- still drawn as before, into an 8-bit
+ * target that rhi_swapchain_view now returns -- is mapped into it at each
+ * present: the game's white at paper_nits, and the brightest parts of the
+ * game's picture (not the menus and text drawn over it) stretched up to
+ * peak_nits. peak_nits 0 or not above paper_nits: no stretch; below 0: the
+ * display's own peak. Off, or a display without HDR, the swap chain is the
+ * 8-bit one it always was and nothing changes. Any thread; the presenting
+ * thread applies it after its next present. rhi_swapchain_readback reads
+ * the 8-bit picture either way, so screenshots and tests do not change. */
+typedef struct RhiHdr {
+    int   on;
+    float paper_nits;
+    float peak_nits;
+} RhiHdr;
+typedef struct RhiHdrStatus {
+    int   active;           /* the swap chain is HDR now */
+    int   display_hdr;      /* the window's display is in HDR mode */
+    float display_peak;     /* its peak in nits as Windows reports it, 0 unknown */
+    float peak_nits;        /* what highlights go up to now (active only) */
+} RhiHdrStatus;
+void        rhi_swapchain_set_hdr(const RhiHdr *hdr);
+/* 1 if the swap chain is HDR now; st (may be NULL) filled in either way. A
+ * backend without HDR reports all zero. Any thread. */
+int         rhi_swapchain_hdr_status(RhiHdrStatus *st);
+/* The game's picture is complete in rhi_swapchain_view: what is drawn into
+ * it after this (menus, counters, touch controls) is kept out of the
+ * highlight stretch. Presenting thread, between the display resolve and
+ * the overlays. A no-op unless HDR is active. */
+void        rhi_swapchain_mark_scene(void);
+
 /* Buffers */
 RhiBuffer *rhi_buffer_create(const RhiBufferDesc *desc, const void *initial);
 void       rhi_buffer_destroy(RhiBuffer *b);
