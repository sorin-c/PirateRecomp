+/* ---- HDR output ------------------------------------------------------------------------- */
+
+/* rhi_swapchain_set_hdr. While HDR is active the swap chain's buffers are
+ * scRGB -- R16G16B16A16_FLOAT, linear, BT.709 primaries, 1.0 = 80 nits --
+ * and the picture is drawn, exactly as before, into an 8-bit target of the
+ * back buffer's size (g_sdr_*), which rhi_swapchain_view hands out. At each
+ * present one full-screen pass maps that into the back buffer: the 8-bit
+ * value decoded with a 2.2 gamma (what the console's TVs showed), white
+ * put at paper white, and, above a knee in luminance, stretched smoothly up
+ * to the peak. The stretch is for the game's picture alone: a copy of it
+ * is kept when it is complete (rhi_swapchain_mark_scene, before the menus
+ * and counters go over it), and a pixel the overlays changed is not
+ * stretched, so white text stays at paper white. Off, the swap chain is the
+ * R8G8B8A8 one it always was, drawn into directly; nothing else runs.
+ *
+ * Only a flip-model swap chain can be FP16, and only a display in HDR mode
+ * shows it as HDR, so both are required. The display is looked at again
+ * every second (the window moves to another screen, Windows' HDR switch is
+ * flipped): through a DXGI factory of our own, made again when it says it
+ * is out of date, since a factory's outputs keep the mode they had when it
+ * was made. The switch itself is a ResizeBuffers to the new format with the
+ * colour space set to match, on the presenting thread, after a present.
+ *
+ * RECOMP_HDR_FORCE=1 makes the swap chain HDR on a display without it (the
+ * picture is then wrong: for checking the path on any machine). */
+#ifndef DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709
+#define DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709 ((DXGI_COLOR_SPACE_TYPE)1)
+#endif
+/* IDXGISwapChain3 and IDXGIOutput6, named here so no particular dxguid.lib
+ * is needed for them. */
+static const GUID RHI_IID_IDXGISwapChain3 =
+    { 0x94d99bdb, 0xf1f8, 0x4ab0, { 0xb2, 0x36, 0x7d, 0xa0, 0x17, 0x0e, 0xda, 0xb1 } };
+static const GUID RHI_IID_IDXGIOutput6 =
+    { 0x068346e8, 0xaaec, 0x4b84, { 0xad, 0xd7, 0x13, 0x7f, 0x51, 0x3f, 0x77, 0xa1 } };
+
+#define HDR_SDR_FORMAT DXGI_FORMAT_R8G8B8A8_UNORM
+#define HDR_OUT_FORMAT DXGI_FORMAT_R16G16B16A16_FLOAT
+#define HDR_KNEE       0.55f    /* linear luminance where highlights start to stretch */
+
+static HWND g_hwnd;             /* the swap chain's window */
+static int  g_flip;             /* the swap chain is the flip model */
+
+/* What was asked for: any thread writes, the presenting thread reads. */
+static volatile LONG g_hdr_req_on;
+static volatile LONG g_hdr_req_paper = 200;
+static volatile LONG g_hdr_req_peak = -1;
+static volatile LONG g_hdr_req_serial;
+/* What is: the presenting thread writes, rhi_swapchain_hdr_status reads. */
+static volatile LONG g_hdr_st_active, g_hdr_st_display, g_hdr_st_display_peak, g_hdr_st_peak;
+
+static int  g_hdr_broken;       /* its shaders or targets could not be made: never again */
+static int  g_hdr_seen_serial = -1;
+static ULONGLONG g_hdr_probe_at;
+static int  g_hdr_display;      /* the window's display is in HDR mode */
+static float g_hdr_display_peak;
+static IDXGIFactory1 *g_hdr_factory;
+static HMONITOR g_hdr_probe_mon;        /* the screen the last probe found */
+
+/* g_sdr_tex, g_sdr_rtv (above): what rhi_swapchain_view draws into */
+static ID3D11ShaderResourceView *g_sdr_srv;
+static ID3D11Texture2D          *g_scene_tex;   /* the game's picture alone */
+static ID3D11ShaderResourceView *g_scene_srv;
+static int                       g_scene_marked; /* g_scene_tex is this frame's */
+static ID3D11VertexShader *g_hdr_vs;
+static ID3D11PixelShader  *g_hdr_ps;
