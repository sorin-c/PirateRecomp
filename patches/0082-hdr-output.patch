+/* HDR output from the settings (hdr, hdr_brightness, hdr_peak), each with
+ * its environment variable over it. */
+void hle_apply_hdr(void)
+{
+    RhiHdr h;
+    int peak = recomp_hdr_peak_parse(recomp_config_lookup("RECOMP_HDR_PEAK", "hdr_peak"));
+    static int said = -1;
+
+    h.on = recomp_config_bool("RECOMP_HDR", "hdr", 0);
+    h.paper_nits = (float)recomp_hdr_brightness_parse(
+        recomp_config_lookup("RECOMP_HDR_BRIGHTNESS", "hdr_brightness"));
+    h.peak_nits = peak == RECOMP_HDR_PEAK_AUTO ? -1.0f : (float)peak;
+    rhi_swapchain_set_hdr(&h);
+    if (said != h.on) {
+        said = h.on;
+        fprintf(stderr, "[HLE-D3D8] HDR output %s\n", h.on ? "asked for" : "off");
+        fflush(stderr);
+    }
+}
