diff --git a/src/hle/hle_d3d8.c b/src/hle/hle_d3d8.c
index 4eed2f5..88b8a3a 100644
--- a/src/hle/hle_d3d8.c
+++ b/src/hle/hle_d3d8.c
@@ -1433,6 +1433,25 @@ uint32_t hle_d3d8_shadow_fvf(void)
     return g_shadow_vs_is_program ? 0u : g_shadow_vs;
 }
 
+/* The texture coordinate sets a draw's host vertex carries, one bit per set
+ * (hle_d3d8_state.c, routed_set): an FVF's first ntex; a fixed-function
+ * declaration's v9-v12 that it lists (ff_from_declaration fills a set it
+ * skips with zeros); all four under a vertex program, which reads its own
+ * registers whatever D3DTSS_TEXCOORDINDEX says. */
+uint32_t hle_d3d8_shadow_texcoord_sets(void)
+{
+    uint32_t sets = 0u, i;
+
+    if (!g_shadow_vs_is_program)
+        return (1u << ((g_shadow_vs >> 8) & 0xFu)) - 1u;
+    if (g_shadow_vs_kind != SHADER_DECLARATION)
+        return 0xFu;
+    for (i = 0; i < 4u; i++)
+        if (HLE_MEM32((g_shadow_vs & ~1u) + 20u + (9u + i) * 16u + 8u) > 0x02u)
+            sets |= 1u << i;
+    return sets;
+}
+
 /* The stream a buffer draw takes its vertices from under the program
  * selected now (struct shadow_program, base_stream); 0 under an FVF. */
 uint32_t hle_d3d8_shadow_base_stream(void)
diff --git a/src/hle/hle_d3d8_state.c b/src/hle/hle_d3d8_state.c
index f3df7db..65a1212 100644
--- a/src/hle/hle_d3d8_state.c
+++ b/src/hle/hle_d3d8_state.c
@@ -1035,32 +1035,37 @@ void hle_d3d8_set_routed_arrays(int on)
     g_routed_arrays = on;
 }
 
-uint32_t hle_d3d8_shadow_fvf(void);   /* hle_d3d8.c */
+uint32_t hle_d3d8_shadow_texcoord_sets(void);   /* hle_d3d8.c */
 
 /* The set a stage reads in a routed draw (g_routed_arrays) that names set
- * `named`. Stage s's own attribute (v9 + s) holds that set, but a draw under
- * an FVF is laid out with only the FVF's sets, v9 .. v9 + ntex - 1
- * (push_gather_fvf, inline_draw): a stage past them has no attribute in the
- * vertex, and reading it gave zeros. Such a stage reads the attribute of an
- * earlier stage that names the same set. Sid Meier's Pirates! draws its
- * characters' heads (hair, beards, the governor's wig) from prebuilt push
- * buffers under a one-set FVF, with a reflection on stage 0 (index 0 with
- * camera-space reflection, so v9 holds set 0) and stages 1 and 2 both at set
- * 0; sent to sets 1 and 2 they took no coordinates and the hair was drawn as
- * one smeared texel. Under a declaration (no FVF) every stage keeps its own. */
+ * `named`. Stage s's own attribute (v9 + s) holds that set, but the host
+ * vertex carries only the sets of the draw's layout
+ * (hle_d3d8_shadow_texcoord_sets): an FVF's v9 .. v9 + ntex - 1
+ * (push_gather_fvf, inline_draw), or the registers a fixed-function
+ * declaration lists (push_gather_from, drawn as its equivalent FVF by
+ * ff_from_declaration). A stage past them has no attribute in the vertex,
+ * and reading it gave zeros. Such a stage reads the attribute of an earlier
+ * stage that names the same set. Sid Meier's Pirates! draws its characters'
+ * heads (hair, beards, the governor's wig) from prebuilt push buffers with a
+ * reflection on stage 0 (index 0 or 1 with camera-space reflection) and the
+ * stages after it at set 0: the town's under a one-set FVF, the ballroom's
+ * dancers (the player's hair and face) under a two-set declaration (v9, v10)
+ * with stages 1-3 at set 0. Sent to sets 2 and 3 they took no coordinates
+ * and the hair was drawn as one smeared texel, in stripes. Under a vertex
+ * program every stage keeps its own. */
 static uint32_t routed_set(uint32_t base_all, int s, uint32_t named)
 {
-    uint32_t fvf = hle_d3d8_shadow_fvf(), ntex = (fvf >> 8) & 0xFu;
+    uint32_t sets = hle_d3d8_shadow_texcoord_sets();
     int j;
 
-    if (!fvf || (uint32_t)s < ntex)
+    if (sets & (1u << s))
         return (uint32_t)s;
-    for (j = 0; j < s && (uint32_t)j < ntex; j++) {
+    for (j = 0; j < s; j++) {
         uint32_t other = HLE_MEM32(base_all + (uint32_t)(j * STAGE_SIZE * 4) + 4 * ts_slot(28));
-        if ((other & 0xFFFFu) == (named & 0xFFFFu))
+        if ((sets & (1u << j)) && (other & 0xFFFFu) == (named & 0xFFFFu))
             return (uint32_t)j;
     }
-    return named < ntex ? named : (uint32_t)s;
+    return named < 4u && (sets & (1u << named)) ? named : (uint32_t)s;
 }
 
 void hle_d3d8_shadow_apply_states(IDirect3DDevice8 *dev)
