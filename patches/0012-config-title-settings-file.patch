+/* The title's settings file in the running executable's folder, or 0. */
+static int beside_exe_file(char *out, size_t n)
+{
+#if defined(RECOMP_TITLE_SETTINGS_FILE)
+    char exe[1024];
+    char *slash;
+    size_t len;
+
+#  if defined(_WIN32)
+    len = (size_t)GetModuleFileNameA(NULL, exe, (DWORD)sizeof exe);
+    if (!len || len >= sizeof exe)
+        return 0;
+    exe[len] = '\0';
+    slash = strrchr(exe, '\\');
+    if (!slash)
+        slash = strrchr(exe, '/');
+#  else
+    len = 0;
+    {
+        long r = -1;
+#    if defined(__linux__)
+        r = (long)readlink("/proc/self/exe", exe, sizeof exe - 1);
+#    endif
+        if (r <= 0)
+            return 0;
+        exe[r] = '\0';
+    }
+    slash = strrchr(exe, '/');
+#  endif
+    if (!slash)
+        return 0;
+    slash[1] = '\0';
+    snprintf(out, n, "%s%s", exe, RECOMP_TITLE_SETTINGS_FILE);
+    return 1;
+#else
+    (void)out;
+    (void)n;
+    return 0;
+#endif
+}
