+/* A title's own settings file, beside its executables.
+ *
+ * RECOMP_TITLE_SETTINGS_FILE (a file name, from the title's CMakeLists)
+ * puts the settings in that file in the folder of the running executable
+ * -- the game and its launcher sit in one folder, so both read and write the
+ * same file -- instead of the per-user one. A player edits it in place.
+ * RECOMP_DISPLAY_CONFIG still names a file outright, and an environment
+ * variable still overrides any line.
+ *
+ * RECOMP_TITLE_SETTINGS_HEADER (a header path) adds the title's own keys:
+ * it defines recomp_title_settings[], { key, default, comment } each, which
+ * recomp_settings_write appends after the toolkit's, keeping the value a key
+ * already has in the file. Without it, a save from the launcher would drop
+ * every key it does not know. */
+#if defined(RECOMP_TITLE_SETTINGS_HEADER)
+#include RECOMP_TITLE_SETTINGS_HEADER
+#define RECOMP_TITLE_SETTINGS_COUNT \
+    ((int)(sizeof recomp_title_settings / sizeof recomp_title_settings[0]))
+#endif
+
 #define MAX_ENTRIES 64
 #define MAX_KEY     64
 #define MAX_VALUE   512
