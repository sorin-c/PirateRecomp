 // ── running the tools ───────────────────────────────────────────────────────
 
+/// The lines a tool prints, each decoded leniently: a tool may print in the
+/// system's code page rather than UTF-8 (Python does to a pipe on Windows,
+/// a disc's title can hold a "™", cmake and zig echo paths), and one
+/// undecodable line must never stop the reading -- with `lines()` it did, the
+/// pipe filled or closed, and the tool's next write failed (EINVAL from
+/// Python's print), so the build died on the title's trade mark sign.
+fn lossy_lines<R: std::io::Read>(r: R) -> impl Iterator<Item = String> {
+    let mut r = BufReader::new(r);
+    std::iter::from_fn(move || {
+        let mut buf = Vec::new();
+        match r.read_until(b'\n', &mut buf) {
+            Ok(0) | Err(_) => None,
+            Ok(_) => {
+                while matches!(buf.last(), Some(b'\n' | b'\r')) { buf.pop(); }
+                Some(String::from_utf8_lossy(&buf).into_owned())
+            }
+        }
+    })
+}
