diff --git a/src/d3d/d3d8_device.c b/src/d3d/d3d8_device.c
index 198c460..71b9b66 100644
--- a/src/d3d/d3d8_device.c
+++ b/src/d3d/d3d8_device.c
@@ -2981,6 +2981,42 @@ void xbox_D3D8SetPresentInterval(UINT interval)
     g_present_interval = interval;
 }
 
+/* The player's VSync (xbox_D3D8SetVsync): -1 until the device that is the
+ * title's display says, and then each present waits for a refresh (1) or
+ * not (0) whatever the interval above. Without it a frame presented while
+ * the display is mid-refresh tears: in fullscreen the swap chain presents
+ * with ALLOW_TEARING for variable refresh, and a frame that comes sooner
+ * than the display's fastest refresh (a scene running unlocked at about
+ * the refresh rate) is shown at once, part way down the screen. With
+ * variable refresh on, a wait only holds back a frame faster than the
+ * display; below that, frames are still shown as they are made. The
+ * title's pacing is the flip gate's, not the present's, so the title's
+ * speed does not change; an uncapped scene is held to the refresh rate.
+ * Any thread sets it; the presenting thread reads it at each present. */
+static volatile LONG g_vsync = -1;
+
+void xbox_D3D8SetVsync(int on)
+{
+    LONG v = on ? 1 : 0;
+
+    if (InterlockedExchange(&g_vsync, v) != v) {
+        fprintf(stderr, "[D3D8] vsync %s\n", v ? "on" : "off");
+        fflush(stderr);
+    }
+}
+
+int xbox_D3D8Vsync(void)
+{
+    return InterlockedCompareExchange(&g_vsync, 0, 0) == 1;
+}
+
+static UINT present_interval(void)
+{
+    LONG v = InterlockedCompareExchange(&g_vsync, 0, 0);
+
+    return v < 0 ? g_present_interval : (UINT)v;
+}
+
 /* RECOMP_FRAME_WORK=1, for measuring: what a frame costs the thread that
  * draws it, apart from the present. Every five seconds, to stderr: frames,
  * the mean frame, the mean time blocked in the present, and the frame's own
@@ -3058,7 +3094,7 @@ static HRESULT __stdcall dev_Swap(IDirect3DDevice8 *self, DWORD Flags)
         LARGE_INTEGER a, b;
         int on = frame_work_on();
         if (on) QueryPerformanceCounter(&a);
-        hr = (HRESULT)rhi_present(g_present_interval);
+        hr = (HRESULT)rhi_present(present_interval());
         if (on) { QueryPerformanceCounter(&b); frame_work_note(a.QuadPart, b.QuadPart); }
         return hr;
     }
@@ -3152,7 +3188,7 @@ void xbox_D3D8InterpPresent(void)
         return;
     follow_vrr();
     present_scene();
-    rhi_present(g_present_interval);
+    rhi_present(present_interval());
 }
 
