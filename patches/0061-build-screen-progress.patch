+/* Once a second: where the build's end should be, from how fast the bar
+ * has moved since the game's files were ready. A raw figure swings with
+ * each stage's real speed, so it is eased in. */
+static void release_eta(void)
+{
+    uint64_t now = lhost_ticks(), spent;
+    double moved = g_build_progress - g_eta_p0, raw_end;
+
+    if (!g_eta_t0 || g_rel_relinking || now - g_eta_last < 1000)
+        return;
+    g_eta_last = now;
+    spent = now - g_eta_t0;
+    if (spent < 8000 || moved < 0.03)
+        return;
+    raw_end = (double)now + (double)spent / moved * (1.0 - g_build_progress);
+    if (!g_eta_have) {
+        g_eta_end = (uint64_t)raw_end;
+        g_eta_have = 1;
+    } else {
+        g_eta_end = (uint64_t)(0.8 * (double)g_eta_end + 0.2 * raw_end);
+    }
+}
