+/// Where a tools.recomp stderr line puts the lift, if anywhere.
+fn lift_err_at(line: &str) -> Option<(u64, String)> {
+    let t = line.trim_start();
+    if t.starts_with("Loaded ") && t.contains(" functions") {
+        return Some((LIFT_LOADED, "Translating the functions".into()));
+    }
+    if t.starts_with("=== Split Translation Complete") {
+        return Some((LIFT_WRITTEN, "Writing the C files".into()));
+    }
+    // "[8000/15967] translated (16 processes)", or with no process pool
+    // "[8001/15967] Translating sub_00123456..."
+    let (nums, after) = t.strip_prefix('[')?.split_once(']')?;
+    let after = after.trim_start();
+    if !after.starts_with("translated") && !after.starts_with("Translating") {
+        return None;
+    }
+    let (d, n) = nums.split_once('/')?;
+    let (d, n) = (d.trim().parse::<u64>().ok()?, n.trim().parse::<u64>().ok()?);
+    if n == 0 {
+        return None;
+    }
+    let d = d.min(n);
+    Some((LIFT_LOADED + (LIFT_TRANSLATED - LIFT_LOADED) * d / n,
+          format!("Translated {d} of {n} functions")))
+}
