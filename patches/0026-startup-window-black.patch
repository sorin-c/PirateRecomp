  * own thread. */
 static WINDOWPLACEMENT g_shadow_restore;
 
+/* Seconds since the process started, for the [STARTUP] lines that say where
+ * a slow start goes (window, first Swaps). */
+static double startup_seconds(void)
+{
+    FILETIME created, exited, kernel, user, now;
+    ULARGE_INTEGER a, b;
+
+    if (!GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user))
+        return -1.0;
+    GetSystemTimeAsFileTime(&now);
+    a.LowPart = created.dwLowDateTime; a.HighPart = created.dwHighDateTime;
+    b.LowPart = now.dwLowDateTime;     b.HighPart = now.dwHighDateTime;
+    return (double)(b.QuadPart - a.QuadPart) / 1e7;
+}
+
