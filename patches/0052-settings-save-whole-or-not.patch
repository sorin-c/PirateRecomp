diff --git a/src/config/recomp_config.c b/src/config/recomp_config.c
index 0bbbb91..0c26c2f 100644
--- a/src/config/recomp_config.c
+++ b/src/config/recomp_config.c
@@ -950,9 +950,36 @@ const char *recomp_config_lookup(const char *env_name, const char *key)
  * file rewritten in place, so the comments and every other line stay as
  * they were. A key the file does not have yet is appended. Returns 1 when
  * the file was written. */
+/* The whole settings file replaced by `data`, or left as it was: written to
+ * a sibling first, and moved over the file only once every byte reached it
+ * (a full disk, say, leaves the old file whole). Returns 1 when replaced. */
+static int write_replace(const char *path, const char *data, size_t n)
+{
+    char tmp[sizeof g_path + 8];
+    FILE *f;
+    int ok;
+
+    if (snprintf(tmp, sizeof tmp, "%s.tmp", path) >= (int)sizeof tmp)
+        return 0;
+    if (!(f = fopen(tmp, "wb")))
+        return 0;
+    ok = fwrite(data, 1, n, f) == n;
+    ok = fflush(f) == 0 && ok;
+    ok = fclose(f) == 0 && ok;
+#if defined(_WIN32)
+    ok = ok && MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH);
+#else
+    ok = ok && rename(tmp, path) == 0;
+#endif
+    if (!ok)
+        remove(tmp);
+    return ok;
+}
+
 int recomp_config_set(const char *key, const char *value)
 {
     FILE *f;
+    int ok;
     char *text = NULL, *out = NULL;
     long size = 0;
     size_t klen, cap, o = 0;
@@ -1013,15 +1040,11 @@ int recomp_config_set(const char *key, const char *value)
                              o && out[o - 1] != '\n' ? "\n" : "", key, value);
     free(text);
     make_parents(g_path);
-    f = fopen(g_path, "wb");
-    if (!f) {
-        free(out);
-        return 0;
-    }
-    fwrite(out, 1, o, f);
-    fclose(f);
+    ok = write_replace(g_path, out, o);
     free(out);
-    return 1;
+    if (!ok)
+        fprintf(stderr, "[CONFIG] could not save %s = %s to %s\n", key, value, g_path);
+    return ok;
 }
 
