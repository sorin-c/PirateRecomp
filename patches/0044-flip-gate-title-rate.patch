+/* A title's own rate for a scene whose logic keeps time (Pirates!' sea with
+ * sea_fps, recomp_manual.c): in force only while the title says so -- it
+ * renews it every frame and the gate drops it 100 ms after the last time --
+ * over the vblank and over the player's cap, which still decide everywhere
+ * else. */
+void xbox_Nv2aFlipGateSetTitleRate(int hz)
+{
+    g_flip_gate_title_ns = host_time_ns();          /* renewed every frame */
+    if (hz == g_flip_gate_title_hz)
+        return;
+    g_flip_gate_title_hz = hz;
+    if (hz > 0)
+        fprintf(stderr, "  [NV2A] flip gate: the title paces this scene at %d Swaps a second "
+                "by the host clock\n", hz);
+    else if (hz < 0)
+        fprintf(stderr, "  [NV2A] flip gate: the title runs this scene unlocked\n");
+    else
+        fprintf(stderr, "  [NV2A] flip gate: back to the vblank and the frame cap\n");
+    fflush(stderr);
+}
+
+int xbox_Nv2aFlipGateTitleRate(void)
+{
+    return g_flip_gate_title_hz;
+}
+
+static void flip_gate_title_paced(int hz)
+{
+    static host_timer *timer;
+    static int64_t next;
+    int64_t period = 1000000000LL / hz;
+    int64_t now = host_time_ns();
+
+    if (!timer)
+        timer = host_timer_create(HOST_TIMER_ANY);
+    if (next && now < next && timer) {
+        int guest_held = xbox_GuestLockDrop();
+        host_timer_wait_until(timer, next, 250);
+        xbox_GuestLockRestore(guest_held);
+        now = host_time_ns();
+    }
+    next = next && now - next < period ? next + period : now + period;
+}
