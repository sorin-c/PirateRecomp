+         * vblank and the cap after 100 ms. */
+        if (host_time_ns() - g_flip_gate_title_ns > 100000000LL) {
+            xbox_Nv2aFlipGateSetTitleRate(0);
+        } else {
+            int hz = g_flip_gate_title_hz;
+            if (hz > 0)
+                flip_gate_title_paced(hz);
+            return;
+        }
