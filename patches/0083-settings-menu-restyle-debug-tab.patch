+inline void rect(const Box &b, Rgba c, float r = 0.0f, ImDrawFlags f = 0)
+{
+    dl->AddRectFilled(ImVec2(b.x0, b.y0), ImVec2(b.x1, b.y1), col(c), r, f);
+}
+inline void frame(const Box &b, Rgba c, float r, float t)
+{
+    dl->AddRect(ImVec2(b.x0, b.y0), ImVec2(b.x1, b.y1), col(c), r, 0, t);
+}
+/* Text centred on (cx, cy). */
+inline void text_c(ImFont *f, float cx, float cy, Rgba c, const char *s)
+{
+    text(f, cx - text_w(f, s) * 0.5f, cy - f->FontSize * 0.5f, c, s);
+}
+
+/* A pad button as the hint bar shows it: a round face button with its
+ * letter, a D-pad (a plus in a circle), or a shoulder button's chip.
+ * Returns the width used. */
+float glyph_face(float x, float cy, const char *letter)
+{
+    const float r = 13 * U;
+    dl->AddCircleFilled(ImVec2(x + r, cy), r, col(kGlyph), 24);
+    text_c(g.small_bold, x + r, cy, kGlyphText, letter);
+    return 2 * r;
+}
+float glyph_dpad(float x, float cy, bool vertical)
+{
+    const float r = 13 * U, a = 8.5f * U, t = 2.6f * U;
+    const float cx = x + r;
+    dl->AddCircleFilled(ImVec2(cx, cy), r, col(kGlyph), 24);
+    /* The arms the hint is about in the dark, the other two faint. */
+    dl->AddRectFilled(ImVec2(cx - t, cy - a), ImVec2(cx + t, cy + a), col(kGlyphText, vertical ? 1.0f : 0.35f), 1 * U);
+    dl->AddRectFilled(ImVec2(cx - a, cy - t), ImVec2(cx + a, cy + t), col(kGlyphText, vertical ? 0.35f : 1.0f), 1 * U);
+    return 2 * r;
+}
+float glyph_chip(float x, float cy, const char *s, Rgba bg, Rgba fg)
+{
+    const float h = 26 * U, w = text_w(g.small_bold, s) + 16 * U;
+    Box b = { x, cy - h * 0.5f, x + (w < h ? h : w), cy + h * 0.5f };
+    rect(b, bg, h * 0.5f);
+    text_c(g.small_bold, (b.x0 + b.x1) * 0.5f, cy, fg, s);
+    return b.x1 - b.x0;
+}
