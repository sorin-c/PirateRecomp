+/* The value a key has when the settings file does not say: the toolkit's
+ * default (recomp_settings_defaults) for its own display keys, the title's
+ * (recomp_title_settings) for the title's, NULL for a key neither knows.
+ * The in-game settings menu shows it and resets to it. */
+const char *recomp_config_default(const char *key)
+{
+    static char buf[32];
+    RecompSettings d;
+    int i;
+
+    if (!key)
+        return NULL;
+#if defined(RECOMP_TITLE_SETTINGS_HEADER)
+    for (i = 0; i < RECOMP_TITLE_SETTINGS_COUNT; i++)
+        if (strcmp(recomp_title_settings[i].key, key) == 0)
+            return recomp_title_settings[i].def;
+#endif
+    recomp_settings_defaults(&d);
+    i = -1;
+    if (strcmp(key, "resolution_scale") == 0)  i = d.resolution_scale;
+    else if (strcmp(key, "widescreen") == 0)   i = d.widescreen;
+    else if (strcmp(key, "anisotropy") == 0)   i = d.anisotropy;
+    else if (strcmp(key, "fps_overlay") == 0)  i = d.fps_overlay;
+    else if (strcmp(key, "fullscreen") == 0)   i = d.fullscreen;
+    else if (strcmp(key, "vrr") == 0)          i = d.vrr;
+    else if (strcmp(key, "frame_interp") == 0) i = d.frame_interp < 1 ? 1 : d.frame_interp;
+    else if (strcmp(key, "frame_cap") == 0)    return "adaptive";
+    else if (strcmp(key, "priority") == 0)     return "1";
+    else if (strcmp(key, "vibration") == 0)    return "100";
+    if (i < 0)
+        return NULL;
+    snprintf(buf, sizeof buf, "%d", i);
+    return buf;
+}
