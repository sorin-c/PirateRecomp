diff --git a/src/d3d/d3d8_menu.cpp b/src/d3d/d3d8_menu.cpp
new file mode 100644
index 0000000..aff5a99
--- /dev/null
+++ b/src/d3d/d3d8_menu.cpp
@@ -0,0 +1,849 @@
+/*
+ * d3d8_menu.cpp -- the in-game settings menu, drawn as a panel.
+ *
+ * src/hle/hle_settings_menu.c owns the menu: its settings, the selection,
+ * what a key does. It hands the state over as a D3D8Menu (d3d8_overlay.h)
+ * and this file draws it over the presented frame, at the window's own
+ * resolution, with Dear ImGui (third_party/imgui): its font atlas, text and
+ * draw lists. No ImGui windows, widgets or navigation -- the layout is
+ * fixed and done here by hand, the pad and the keyboard are the menu's, and
+ * the pointer is hit-tested here against the same rectangles that were
+ * drawn and reported back as actions.
+ *
+ * The look: a dark sea-blue panel with brass, tabs along the top, the rows
+ * on the left with "applies now" or "after restart" under each, and the
+ * selected row's description on the right.
+ *
+ * Drawing goes through rhi.h like the rest of the renderer, so it is the
+ * same on D3D11 and Vulkan: one dynamic vertex and index buffer, the font
+ * atlas as one texture, a scissor per draw command, alpha blending. The
+ * output state is saved and put back, as the text overlay does.
+ */
+#include "d3d8_overlay.h"
+
+#include "imgui.h"
+
+#include <math.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <mutex>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+namespace {
+
+/* ---- the state handed over, and what the pointer did ------------------ */
+
+std::mutex g_lock;
+D3D8Menu   g_menu;                      /* the menu's latest, under g_lock */
+bool       g_menu_set;
+
+enum { ACT_RING = 16 };
+D3D8MenuAction g_acts[ACT_RING];        /* under g_lock */
+int            g_act_head, g_act_count;
+
+void push_action(int kind, int index, int step)
+{
+    std::lock_guard<std::mutex> hold(g_lock);
+    if (g_act_count == ACT_RING) {      /* full: the oldest goes */
+        g_act_head = (g_act_head + 1) % ACT_RING;
+        g_act_count--;
+    }
+    D3D8MenuAction &a = g_acts[(g_act_head + g_act_count) % ACT_RING];
+    a.kind = kind;
+    a.index = index;
+    a.step = step;
+    g_act_count++;
+}
+
+/* The pointer, written by the window's thread. */
+volatile int g_ptr_x = -1, g_ptr_y = -1, g_ptr_inside;
+volatile int g_ptr_down;
+volatile unsigned g_ptr_presses;        /* left-button downs so far */
+volatile int g_ptr_press_x, g_ptr_press_y;
+volatile int g_wheel;                   /* WHEEL_DELTA units not yet used */
+
+/* ---- the look ----------------------------------------------------------- */
+
+struct Rgba { float r, g, b, a; };
+inline ImU32 col(Rgba c, float alpha = 1.0f)
+{
+    return IM_COL32((int)(c.r * 255.0f + 0.5f), (int)(c.g * 255.0f + 0.5f),
+                    (int)(c.b * 255.0f + 0.5f), (int)(c.a * alpha * 255.0f + 0.5f));
+}
+inline Rgba hex(unsigned v, float a = 1.0f)
+{
+    return Rgba{ ((v >> 16) & 255) / 255.0f, ((v >> 8) & 255) / 255.0f, (v & 255) / 255.0f, a };
+}
+
+const Rgba kDim       = { 0.016f, 0.04f, 0.07f, 0.45f };  /* over the game */
+const Rgba kPanel     = { 0.04f, 0.086f, 0.133f, 0.92f };
+const Rgba kLine      = { 0.77f, 0.63f, 0.36f, 0.35f };
+const Rgba kRow       = { 1.0f, 1.0f, 1.0f, 0.045f };
+const Rgba kRowSel    = { 0.84f, 0.67f, 0.33f, 0.16f };
+const Rgba kBrass     = hex(0xD6AA54);
+const Rgba kBrassDim  = hex(0x9C7C43);
+const Rgba kText      = hex(0xEBE4D4);
+const Rgba kBodyText  = hex(0xCFD6DC);
+const Rgba kMuted     = hex(0x9AA6B2);
+const Rgba kNow       = hex(0x7FC8A9);
+const Rgba kRestart   = hex(0xE0A66A);
+const Rgba kExp       = hex(0xC79BE0);
+const Rgba kWarn      = hex(0xE5736A);
+const Rgba kPip       = { 1.0f, 1.0f, 1.0f, 0.18f };
+const Rgba kPill      = { 1.0f, 1.0f, 1.0f, 0.12f };
+const Rgba kButton    = { 1.0f, 1.0f, 1.0f, 0.08f };
+const Rgba kPadA      = hex(0x3F8F3A);
+const Rgba kPadB      = hex(0xB5382F);
+const Rgba kPadY      = hex(0xC8A02A);
+
+/* The panel in layout units: 1280x720 is the design; u is pixels per unit. */
+const float PANEL_W = 980.0f, PANEL_H = 580.0f;
+
+/* ---- the renderer ------------------------------------------------------- */
+
+const char kShaderSource[] =
+    "cbuffer Menu : register(b7) {\n"
+    "    float4 xform;       // scale.xy, offset.xy: pixels to clip space\n"
+    "};\n"
+    "struct VSIn  { float2 pos : POSITION; float2 uv : TEXCOORD0; float4 col : COLOR0; };\n"
+    "struct VSOut { float4 pos : SV_Position; float4 col : COLOR0; float2 uv : TEXCOORD0; };\n"
+    "VSOut vs_main(VSIn i) {\n"
+    "    VSOut o;\n"
+    "    o.pos = float4(i.pos * xform.xy + xform.zw, 0, 1);\n"
+    "    o.col = i.col;\n"
+    "    o.uv  = i.uv;\n"
+    "    return o;\n"
+    "}\n"
+    "Texture2D<float4> tex : register(t8);\n"
+    "SamplerState smp : register(s8);\n"
+    "float4 ps_main(VSOut i) : SV_Target {\n"
+    "    return i.col * tex.Sample(smp, i.uv);\n"
+    "}\n";
+
+struct Gpu {
+    bool            tried, failed;
+    ImGuiContext   *ctx;
+    RhiShader      *vs, *ps;
+    RhiVertexLayout *layout;
+    RhiBuffer      *cb, *vb, *ib;
+    uint32_t        vb_cap, ib_cap;     /* in vertices, indices */
+    RhiImage       *font_img;
+    RhiView        *font_srv;
+    RhiSampler     *sampler;
+    RhiBlendState  *blend;
+    RhiDepthState  *depth;
+    RhiRasterState *raster;
+    float           font_u;             /* the scale the atlas was built for */
+    ImFont         *body, *body_bold, *small, *small_bold, *title, *heading;
+} g;
+
+void gpu_fail(const char *what)
+{
+    g.failed = true;
+    fprintf(stderr, "D3D8 menu: %s failed; the settings menu falls back to text\n", what);
+    fflush(stderr);
+    d3d8_menu_shutdown();
+    g.failed = true;
+}
+
+RhiShader *compile_one(uint32_t stage, const char *entry, const char *target)
+{
+    RhiShaderSource src;
+    char err[2048];
+
+    memset(&src, 0, sizeof src);
+    src.hlsl = kShaderSource;
+    src.len = sizeof kShaderSource - 1;
+    src.name = "menu";
+    src.entry = entry;
+    src.target = target;
+    err[0] = '\0';
+    RhiShader *s = rhi_shader_create(stage, &src, err, sizeof err);
+    if (!s && err[0])
+        fprintf(stderr, "D3D8 menu: %s\n", err);
+    return s;
+}
+
+bool gpu_create()
+{
+    if (g.failed) return false;
+    if (g.tried) return g.vs != NULL;
+    g.tried = true;
+    if (!rhi_device_ready()) { g.failed = true; return false; }
+
+    IMGUI_CHECKVERSION();
+    g.ctx = ImGui::CreateContext();
+    ImGuiIO &io = ImGui::GetIO();
+    io.IniFilename = NULL;              /* nothing on disk */
+    io.LogFilename = NULL;
+    io.BackendRendererName = "xboxrecomp_rhi";
+    io.BackendFlags |= ImGuiBackendFlags_RendererHasVtxOffset;
+
+    if (!(g.vs = compile_one(RHI_STAGE_VERTEX, "vs_main", "vs_4_0"))) { gpu_fail("the vertex shader"); return false; }
+    if (!(g.ps = compile_one(RHI_STAGE_PIXEL, "ps_main", "ps_4_0")))  { gpu_fail("the pixel shader"); return false; }
+
+    {
+        RhiVertexElement e[3];
+        memset(e, 0, sizeof e);
+        e[0].semantic = "POSITION"; e[0].format = RHI_FORMAT_R32G32_FLOAT;  e[0].offset = (uint32_t)offsetof(ImDrawVert, pos);
+        e[1].semantic = "TEXCOORD"; e[1].format = RHI_FORMAT_R32G32_FLOAT;  e[1].offset = (uint32_t)offsetof(ImDrawVert, uv);
+        e[2].semantic = "COLOR";    e[2].format = RHI_FORMAT_R8G8B8A8_UNORM; e[2].offset = (uint32_t)offsetof(ImDrawVert, col);
+        if (!(g.layout = rhi_vertex_layout_create(e, 3, g.vs))) { gpu_fail("the vertex layout"); return false; }
+    }
+    {
+        RhiBufferDesc bd;
+        memset(&bd, 0, sizeof bd);
+        bd.size = 16;
+        bd.usage = RHI_USAGE_DYNAMIC;
+        bd.bind = RHI_BIND_UNIFORM;
+        bd.cpu_access = RHI_CPU_WRITE;
+        if (!(g.cb = rhi_buffer_create(&bd, NULL))) { gpu_fail("the constant buffer"); return false; }
+    }
+    {
+        RhiSamplerDesc sd;
+        memset(&sd, 0, sizeof sd);
+        sd.filter = RHI_FILTER_LINEAR;
+        sd.address_u = sd.address_v = sd.address_w = RHI_ADDRESS_CLAMP;
+        sd.max_anisotropy = 1;
+        sd.compare = RHI_CMP_ALWAYS;
+        sd.min_lod = 0.0f;
+        sd.max_lod = 0.0f;
+        if (!(g.sampler = rhi_sampler_create(&sd))) { gpu_fail("the sampler"); return false; }
+    }
+    {
+        RhiBlendDesc bl;
+        memset(&bl, 0, sizeof bl);
+        bl.enable = 1;
+        bl.src = RHI_BLEND_SRC_ALPHA;
+        bl.dst = RHI_BLEND_INV_SRC_ALPHA;
+        bl.op = RHI_BLEND_OP_ADD;
+        bl.src_alpha = RHI_BLEND_ONE;
+        bl.dst_alpha = RHI_BLEND_INV_SRC_ALPHA;
+        bl.op_alpha = RHI_BLEND_OP_ADD;
+        bl.write_mask = RHI_WRITE_ALL;
+        if (!(g.blend = rhi_blend_state_create(&bl))) { gpu_fail("the blend state"); return false; }
+    }
+    {
+        RhiDepthDesc ds;
+        memset(&ds, 0, sizeof ds);
+        if (!(g.depth = rhi_depth_state_create(&ds))) { gpu_fail("the depth state"); return false; }
+    }
+    {
+        RhiRasterDesc rd;
+        memset(&rd, 0, sizeof rd);
+        rd.fill = RHI_FILL_SOLID;
+        rd.cull = RHI_CULL_NONE;
+        rd.depth_clip = 1;
+        rd.scissor = 1;
+        if (!(g.raster = rhi_raster_state_create(&rd))) { gpu_fail("the raster state"); return false; }
+    }
+    return true;
+}
+
+/* ---- fonts -------------------------------------------------------------- */
+
+/* A face from Windows' own fonts folder, or ImGui's built-in one. */
+ImFont *add_font(const char *const *files, float px)
+{
+    ImGuiIO &io = ImGui::GetIO();
+    ImFontConfig cfg;
+    cfg.OversampleH = 2;
+    cfg.OversampleV = 1;
+    cfg.PixelSnapH = false;
+#if defined(_WIN32)
+    char dir[MAX_PATH];
+    UINT n = GetWindowsDirectoryA(dir, sizeof dir);
+    if (n && n < sizeof dir - 32) {
+        for (; *files; files++) {
+            char path[MAX_PATH];
+            snprintf(path, sizeof path, "%s\\Fonts\\%s", dir, *files);
+            if (GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES) {
+                ImFont *f = io.Fonts->AddFontFromFileTTF(path, px, &cfg);
+                if (f) return f;
+            }
+        }
+    }
+#else
+    (void)files;
+#endif
+    ImFontConfig def;
+    def.SizePixels = px;
+    return io.Fonts->AddFontDefault(&def);
+}
+
+void font_texture_release()
+{
+    rhi_view_destroy(g.font_srv);  g.font_srv = NULL;
+    rhi_image_destroy(g.font_img); g.font_img = NULL;
+}
+
+/* The atlas for unit size u: rebuilt when the window's size moves it by
+ * more than a few percent, so text is drawn at its own pixel size. */
+bool fonts_for(float u)
+{
+    if (g.font_img && fabsf(u - g.font_u) < g.font_u * 0.04f)
+        return true;
+    static const char *const regular[] = { "segoeui.ttf", "arial.ttf", NULL };
+    static const char *const semibold[] = { "seguisb.ttf", "segoeuib.ttf", "arialbd.ttf", NULL };
+    static const char *const serif[] = { "georgiab.ttf", "timesbd.ttf", "seguisb.ttf", NULL };
+    ImGuiIO &io = ImGui::GetIO();
+
+    font_texture_release();
+    io.Fonts->Clear();
+    g.body       = add_font(regular,  17.0f * u);
+    g.body_bold  = add_font(semibold, 17.0f * u);
+    g.small      = add_font(regular,  13.5f * u);
+    g.small_bold = add_font(semibold, 13.0f * u);
+    g.title      = add_font(serif,    27.0f * u);
+    g.heading    = add_font(serif,    20.0f * u);
+    if (!io.Fonts->Build()) { gpu_fail("the font atlas"); return false; }
+
+    unsigned char *px = NULL;
+    int w = 0, h = 0;
+    io.Fonts->GetTexDataAsRGBA32(&px, &w, &h);
+    RhiImageDesc td;
+    memset(&td, 0, sizeof td);
+    td.type = RHI_IMAGE_2D;
+    td.width = (uint32_t)w;
+    td.height = (uint32_t)h;
+    td.depth = 1;
+    td.mip_levels = 1;
+    td.format = RHI_FORMAT_R8G8B8A8_UNORM;
+    td.samples = 1;
+    td.usage = RHI_USAGE_IMMUTABLE;
+    td.bind = RHI_BIND_SAMPLED;
+    RhiSubresourceData init;
+    init.data = px;
+    init.row_pitch = (uint32_t)w * 4u;
+    init.slice_pitch = init.row_pitch * (uint32_t)h;
+    if (!(g.font_img = rhi_image_create(&td, &init))) { gpu_fail("the font texture"); return false; }
+    if (!(g.font_srv = rhi_view_create(g.font_img, RHI_VIEW_SAMPLED, NULL))) { gpu_fail("the font view"); return false; }
+    io.Fonts->SetTexID((ImTextureID)(uintptr_t)g.font_srv);
+    io.Fonts->ClearTexData();           /* the GPU has it now */
+    g.font_u = u;
+    return true;
+}
+
+/* ---- drawing helpers ---------------------------------------------------- */
+
+struct Box { float x0, y0, x1, y1; };
+inline bool inside(const Box &b, float x, float y) { return x >= b.x0 && x < b.x1 && y >= b.y0 && y < b.y1; }
+
+ImDrawList *dl;
+float U;                                /* pixels per layout unit */
+
+inline float text_w(ImFont *f, const char *s)
+{
+    return f->CalcTextSizeA(f->FontSize, 1e9f, 0.0f, s).x;
+}
+inline void text(ImFont *f, float x, float y, Rgba c, const char *s, float alpha = 1.0f)
+{
+    dl->AddText(f, f->FontSize, ImVec2(floorf(x), floorf(y)), col(c, alpha), s);
+}
+/* Wrapped to width w; returns the height used. */
+float text_wrapped(ImFont *f, float x, float y, float w, Rgba c, const char *s)
+{
+    dl->AddText(f, f->FontSize, ImVec2(floorf(x), floorf(y)), col(c), s, NULL, w);
+    return f->CalcTextSizeA(f->FontSize, 1e9f, w, s).y;
+}
+
+/* A controller-button pill ("A", "LB"). Returns its width. */
+float pill(float x, float cy, const char *label, Rgba bg, Rgba fg)
+{
+    float tw = text_w(g.small_bold, label);
+    float w = tw + 12.0f * U, h = 22.0f * U;
+    if (w < 30.0f * U) w = 30.0f * U;
+    dl->AddRectFilled(ImVec2(x, cy - h * 0.5f), ImVec2(x + w, cy + h * 0.5f), col(bg), h * 0.5f);
+    text(g.small_bold, x + (w - tw) * 0.5f, cy - g.small_bold->FontSize * 0.5f, fg, label);
+    return w;
+}
+
+void triangle(float cx, float cy, float s, int dir, Rgba c)
+{
+    /* dir -1 points left, 1 right */
+    ImVec2 a(cx + dir * s * 0.55f, cy), b(cx - dir * s * 0.45f, cy - s * 0.6f), d(cx - dir * s * 0.45f, cy + s * 0.6f);
+    dl->AddTriangleFilled(a, b, d, col(c));
+}
+
+/* ---- the layout --------------------------------------------------------- */
+
+float g_scroll;                         /* the row list's, in pixels */
+unsigned g_seen_serial = ~0u;
+int g_hover_row = -1;
+unsigned g_seen_presses;
+
+void layout_and_draw(const D3D8Menu &m, float W, float H, float px0, float py0)
+{
+    const float u = U;
+    const float x0 = px0, y0 = py0, x1 = px0 + PANEL_W * u, y1 = py0 + PANEL_H * u;
+
+    /* The pointer, as of this frame. */
+    const bool ptr_in = g_ptr_inside != 0;
+    const float mx = (float)g_ptr_x, my = (float)g_ptr_y;
+    unsigned presses = g_ptr_presses;
+    bool clicked = false;
+    float cx = 0, cy = 0;
+    if (presses != g_seen_presses) {
+        clicked = true;
+        cx = (float)g_ptr_press_x;
+        cy = (float)g_ptr_press_y;
+        g_seen_presses = presses;
+    }
+    int wheel = g_wheel;
+    g_wheel = 0;                        /* a notch landing in between is lost: harmless */
+
+    /* Dim the game, then the panel. */
+    dl->AddRectFilled(ImVec2(0, 0), ImVec2(W, H), col(kDim));
+    dl->AddRectFilled(ImVec2(x0, y0), ImVec2(x1, y1), col(kPanel), 10.0f * u);
+    dl->AddRect(ImVec2(x0, y0), ImVec2(x1, y1), col(kLine), 10.0f * u, 0, 1.5f * u);
+
+    /* Header. */
+    text(g.title, x0 + 26 * u, y0 + 16 * u, kBrass, m.title);
+    if (m.subtitle[0]) {
+        float w = text_w(g.small, m.subtitle);
+        text(g.small, x1 - 26 * u - w, y0 + 26 * u, kMuted, m.subtitle);
+    }
+
+    /* Tabs. */
+    const float tab_y0 = y0 + 58 * u, tab_y1 = y0 + 98 * u, tab_cy = (tab_y0 + tab_y1) * 0.5f;
+    float tx = x0 + 22 * u;
+    tx += pill(tx, tab_cy, "LB", kPill, kText) + 6 * u;
+    for (int i = 0; i < m.tab_count; i++) {
+        float w = text_w(g.body_bold, m.tabs[i]) + 32 * u;
+        Box b = { tx, tab_y0, tx + w, tab_y1 };
+        bool on = i == m.tab, hot = ptr_in && inside(b, mx, my);
+        text(g.body_bold, tx + 16 * u, tab_cy - g.body_bold->FontSize * 0.55f, on ? kBrass : (hot ? kText : kMuted), m.tabs[i]);
+        if (on)
+            dl->AddRectFilled(ImVec2(tx, tab_y1 - 3 * u), ImVec2(tx + w, tab_y1), col(kBrass));
+        if (clicked && inside(b, cx, cy))
+            push_action(D3D8_MENU_ACT_TAB, i, 0);
+        tx += w + 4 * u;
+    }
+    pill(tx + 6 * u, tab_cy, "RB", kPill, kText);
+    dl->AddLine(ImVec2(x0, tab_y1), ImVec2(x1, tab_y1), col(kLine), 1.0f * u);
+
+    /* Body: rows left, description right. */
+    const float foot_y0 = y1 - 58 * u;
+    const float split = x0 + 596 * u;
+    const Box list = { x0 + 20 * u, tab_y1 + 1, split - 14 * u, foot_y0 - 1 };
+    dl->AddLine(ImVec2(split, tab_y1), ImVec2(split, foot_y0), col(kLine), 1.0f * u);
+
+    /* Row heights, to scroll. */
+    const float pad_top = 14 * u, gap = 5 * u, group_h = 30 * u, row_h = 54 * u, info_h = 34 * u;
+    float total = pad_top, sel_top = -1, sel_bot = -1;
+    for (int i = 0; i < m.row_count; i++) {
+        const D3D8MenuRow &r = m.rows[i];
+        float h = r.kind == D3D8_MENU_ROW_GROUP ? group_h : r.kind == D3D8_MENU_ROW_INFO ? info_h : row_h;
+        if (i == m.sel) { sel_top = total; sel_bot = total + h; }
+        total += h + gap;
+    }
+    total += 14 * u;
+    const float view_h = list.y1 - list.y0;
+    if (ptr_in && inside(list, mx, my) && wheel)
+        g_scroll -= (float)wheel / 120.0f * 60.0f * u;
+    if (m.serial != g_seen_serial) {    /* a key moved the selection: show it */
+        g_seen_serial = m.serial;
+        if (sel_top >= 0) {
+            if (sel_top - 8 * u < g_scroll) g_scroll = sel_top - (sel_top < 2 * row_h ? sel_top : 8 * u);
+            if (sel_bot + 8 * u > g_scroll + view_h) g_scroll = sel_bot + 8 * u - view_h;
+        }
+        if (m.sel < 0 && m.button < 0) g_scroll = 0;
+    }
+    if (g_scroll > total - view_h) g_scroll = total - view_h;
+    if (g_scroll < 0) g_scroll = 0;
+
+    dl->PushClipRect(ImVec2(list.x0 - 2 * u, list.y0), ImVec2(list.x1 + 2 * u, list.y1), true);
+    float y = list.y0 + pad_top - g_scroll;
+    int hover = -1;
+    for (int i = 0; i < m.row_count; i++) {
+        const D3D8MenuRow &r = m.rows[i];
+        if (r.kind == D3D8_MENU_ROW_GROUP) {
+            /* Uppercase, spaced a little. */
+            char up[48];
+            size_t k;
+            for (k = 0; r.label[k] && k < sizeof up - 1; k++)
+                up[k] = (r.label[k] >= 'a' && r.label[k] <= 'z') ? (char)(r.label[k] - 32) : r.label[k];
+            up[k] = '\0';
+            text(g.small_bold, list.x0 + 6 * u, y + 12 * u, kBrassDim, up);
+            y += group_h + gap;
+            continue;
+        }
+        if (r.kind == D3D8_MENU_ROW_INFO) {
+            Box b = { list.x0, y, list.x1, y + info_h };
+            dl->AddRectFilled(ImVec2(b.x0, b.y0), ImVec2(b.x1, b.y1), col(kRow), 6 * u);
+            text(g.body, b.x0 + 12 * u, y + (info_h - g.body->FontSize) * 0.5f, kMuted, r.label);
+            float vw = text_w(g.body_bold, r.value);
+            float vx = b.x1 - 12 * u - vw;
+            if (vx < b.x0 + 180 * u) vx = b.x0 + 180 * u;
+            dl->PushClipRect(ImVec2(vx, b.y0), ImVec2(b.x1 - 6 * u, b.y1), true);
+            text(g.body_bold, vx, y + (info_h - g.body_bold->FontSize) * 0.5f, kText, r.value);
+            dl->PopClipRect();
+            y += info_h + gap;
+            continue;
+        }
+        Box b = { list.x0, y, list.x1, y + row_h };
+        const bool sel = i == m.sel && m.button < 0;
+        const bool visible = b.y1 > list.y0 && b.y0 < list.y1;
+        dl->AddRectFilled(ImVec2(b.x0, b.y0), ImVec2(b.x1, b.y1), col(sel ? kRowSel : kRow), 6 * u);
+        if (sel)
+            dl->AddRect(ImVec2(b.x0, b.y0), ImVec2(b.x1, b.y1), col(kBrass), 6 * u, 0, 1.5f * u);
+
+        /* Label and its tags. */
+        text(g.body_bold, b.x0 + 12 * u, y + 8 * u, kText, r.label);
+        {
+            float tx2 = b.x0 + 12 * u, ty = y + 32 * u;
+            struct { int bit; const char *s; Rgba c; } tags[] = {
+                { D3D8_MENU_TAG_NOW, "Applies now", kNow },
+                { D3D8_MENU_TAG_RESTART, "After restart", kRestart },
+                { D3D8_MENU_TAG_EXPERIMENTAL, "Experimental", kExp },
+                { D3D8_MENU_TAG_CHANGED, "Changed", kBrass },
+                { D3D8_MENU_TAG_ENV, "Set by environment", kWarn },
+            };
+            for (auto &t : tags) {
+                if (!(r.tags & t.bit)) continue;
+                text(g.small, tx2, ty, t.c, t.s);
+                tx2 += text_w(g.small, t.s) + 10 * u;
+            }
+        }
+
+        /* The value between its arrows, the pips under it. */
+        const float val_w = 120 * u;
+        const float right = b.x1 - 14 * u;
+        const float vcx = right - 16 * u - val_w * 0.5f;
+        const float vcy = y + 20 * u;
+        Rgba arrow = sel ? kBrass : kMuted;
+        Box left_hit = { right - 16 * u - val_w - 26 * u, b.y0, right - 16 * u - val_w + 6 * u, b.y1 };
+        triangle(right - 16 * u - val_w - 8 * u, vcy, 11 * u, -1, arrow);
+        triangle(right - 6 * u, vcy, 11 * u, 1, arrow);
+        {
+            float vw = text_w(g.body_bold, r.value);
+            text(g.body_bold, vcx - vw * 0.5f, vcy - g.body_bold->FontSize * 0.55f, kText, r.value);
+        }
+        if (r.count > 1 && r.count <= 16) {
+            const float d = 7 * u, sp = 4 * u;
+            float pw = r.count * d + (r.count - 1) * sp;
+            float pxs = vcx - pw * 0.5f, pcy = y + 40 * u;
+            for (int k = 0; k < r.count; k++) {
+                ImVec2 c(pxs + k * (d + sp) + d * 0.5f, pcy);
+                dl->AddCircleFilled(c, d * 0.5f, col(k == r.index ? kBrass : kPip), 12);
+                if (k == r.def)
+                    dl->AddCircle(c, d * 0.5f + 1.0f * u, col(Rgba{1, 1, 1, 0.55f}), 12, 1.3f * u);
+            }
+        }
+
+        /* The pointer. */
+        if (visible) {
+            if (ptr_in && inside(b, mx, my) && inside(list, mx, my))
+                hover = i;
+            if (clicked && inside(b, cx, cy) && inside(list, cx, cy)) {
+                int step = inside(left_hit, cx, cy) ? -1 : 1;
+                push_action(D3D8_MENU_ACT_STEP, i, step);
+                clicked = false;
+            }
+        }
+        y += row_h + gap;
+    }
+    dl->PopClipRect();
+    if (hover != g_hover_row) {
+        g_hover_row = hover;
+        if (hover >= 0 && hover != m.sel)
+            push_action(D3D8_MENU_ACT_HOVER, hover, 0);
+    }
+    /* A scroll hint: a thin bar when the list is longer than its box. */
+    if (total > view_h + 1) {
+        float bh = view_h * view_h / total, by = list.y0 + (view_h - bh) * (g_scroll / (total - view_h));
+        dl->AddRectFilled(ImVec2(list.x1 + 6 * u, by), ImVec2(list.x1 + 9 * u, by + bh), col(kLine), 2 * u);
+    }
+
+    /* The description. */
+    {
+        const float ix = split + 24 * u, iw = x1 - 24 * u - ix;
+        float iy = tab_y1 + 20 * u;
+        if (m.info_title[0]) {
+            text(g.heading, ix, iy, kText, m.info_title);
+            iy += g.heading->FontSize + 12 * u;
+        }
+        if (m.info_text[0])
+            iy += text_wrapped(g.body, ix, iy, iw, kBodyText, m.info_text) + 14 * u;
+        struct { const char *k, *v; } dl_rows[] = {
+            { "Default", m.info_default }, { "Takes effect", m.info_when }, { "Options", m.info_options },
+        };
+        const float kw = 100 * u;
+        for (auto &d : dl_rows) {
+            if (!d.v[0]) continue;
+            text(g.small, ix, iy, kMuted, d.k);
+            iy += text_wrapped(g.small, ix + kw, iy, iw - kw, kText, d.v) + 6 * u;
+        }
+        if (m.warning[0]) {
+            iy += 8 * u;
+            text_wrapped(g.small, ix, iy, iw, kWarn, m.warning);
+        }
+    }
+
+    /* Footer: the buttons' hints, the status, Resume and Quit. */
+    dl->AddLine(ImVec2(x0, foot_y0), ImVec2(x1, foot_y0), col(kLine), 1.0f * u);
+    {
+        const float fcy = (foot_y0 + y1) * 0.5f;
+        float fx = x0 + 22 * u;
+        struct { const char *g1, *g2; Rgba bg; Rgba fg; const char *what; } hints[] = {
+            { "LB", "RB", kPill, kText, "Tabs" },
+            { "A", NULL, kPadA, kText, "Change" },
+            { "Y", NULL, kPadY, hex(0x1A1300), "Default" },
+            { "B", NULL, kPadB, kText, "Back" },
+        };
+        for (auto &h : hints) {
+            fx += pill(fx, fcy, h.g1, h.bg, h.fg) + 4 * u;
+            if (h.g2) fx += pill(fx, fcy, h.g2, h.bg, h.fg) + 4 * u;
+            text(g.small, fx + 2 * u, fcy - g.small->FontSize * 0.55f, kMuted, h.what);
+            fx += text_w(g.small, h.what) + 16 * u;
+        }
+
+        static const char *const labels[2] = { "Resume", "Quit game" };
+        float bx = x1 - 22 * u;
+        for (int i = 1; i >= 0; i--) {
+            float w = text_w(g.body_bold, labels[i]) + 36 * u, h = 36 * u;
+            Box b = { bx - w, fcy - h * 0.5f, bx, fcy + h * 0.5f };
+            bool on = m.button == i, hot = ptr_in && inside(b, mx, my);
+            dl->AddRectFilled(ImVec2(b.x0, b.y0), ImVec2(b.x1, b.y1), col(on ? kRowSel : kButton, hot && !on ? 1.6f : 1.0f), 6 * u);
+            if (on)
+                dl->AddRect(ImVec2(b.x0, b.y0), ImVec2(b.x1, b.y1), col(kBrass), 6 * u, 0, 1.5f * u);
+            text(g.body_bold, b.x0 + 18 * u, fcy - g.body_bold->FontSize * 0.55f, kText, labels[i]);
+            if (clicked && inside(b, cx, cy))
+                push_action(D3D8_MENU_ACT_BUTTON, i, 0);
+            bx = b.x0 - 10 * u;
+        }
+        if (m.status[0]) {
+            float sw = text_w(g.small_bold, m.status);
+            if (fx + sw < bx - 10 * u)
+                text(g.small_bold, fx, fcy - g.small_bold->FontSize * 0.55f, kRestart, m.status);
+        }
+    }
+}
+
+/* ---- submitting ImGui's draw data through rhi.h ------------------------- */
+
+bool ensure_buffer(RhiBuffer **b, uint32_t *cap, uint32_t need, uint32_t elem, uint32_t bind)
+{
+    if (*b && *cap >= need) return true;
+    rhi_buffer_destroy(*b);
+    *b = NULL;
+    uint32_t n = need + need / 2 + 1024;
+    RhiBufferDesc bd;
+    memset(&bd, 0, sizeof bd);
+    bd.size = n * elem;
+    bd.usage = RHI_USAGE_DYNAMIC;
+    bd.bind = bind;
+    bd.cpu_access = RHI_CPU_WRITE;
+    if (!(*b = rhi_buffer_create(&bd, NULL))) { *cap = 0; return false; }
+    *cap = n;
+    return true;
+}
+
+void submit(ImDrawData *dd, RhiView *out, unsigned w, unsigned h)
+{
+    if (!dd || dd->TotalVtxCount <= 0) return;
+    if (!ensure_buffer(&g.vb, &g.vb_cap, (uint32_t)dd->TotalVtxCount, sizeof(ImDrawVert), RHI_BIND_VERTEX) ||
+        !ensure_buffer(&g.ib, &g.ib_cap, (uint32_t)dd->TotalIdxCount, sizeof(ImDrawIdx), RHI_BIND_INDEX)) {
+        gpu_fail("the vertex buffers");
+        return;
+    }
+    ImDrawVert *vtx = (ImDrawVert *)rhi_buffer_map(g.vb, RHI_MAP_WRITE_DISCARD);
+    ImDrawIdx *idx = (ImDrawIdx *)rhi_buffer_map(g.ib, RHI_MAP_WRITE_DISCARD);
+    if (!vtx || !idx) {
+        if (vtx) rhi_buffer_unmap(g.vb);
+        if (idx) rhi_buffer_unmap(g.ib);
+        return;
+    }
+    for (int n = 0; n < dd->CmdListsCount; n++) {
+        const ImDrawList *cl = dd->CmdLists[n];
+        memcpy(vtx, cl->VtxBuffer.Data, (size_t)cl->VtxBuffer.Size * sizeof(ImDrawVert));
+        memcpy(idx, cl->IdxBuffer.Data, (size_t)cl->IdxBuffer.Size * sizeof(ImDrawIdx));
+        vtx += cl->VtxBuffer.Size;
+        idx += cl->IdxBuffer.Size;
+    }
+    rhi_buffer_unmap(g.vb);
+    rhi_buffer_unmap(g.ib);
+
+    float *c = (float *)rhi_buffer_map(g.cb, RHI_MAP_WRITE_DISCARD);
+    if (!c) return;
+    c[0] = 2.0f / (float)w;
+    c[1] = -2.0f / (float)h;
+    c[2] = -1.0f;
+    c[3] = 1.0f;
+    rhi_buffer_unmap(g.cb);
+
+    RhiViewport vp;
+    vp.x = vp.y = 0.0f;
+    vp.width = (float)w;
+    vp.height = (float)h;
+    vp.min_depth = 0.0f;
+    vp.max_depth = 1.0f;
+    float blend_factor[4] = { 1, 1, 1, 1 };
+    rhi_set_render_target(out, NULL);
+    rhi_set_viewports(1, &vp);
+    rhi_set_vertex_layout(g.layout);
+    rhi_set_vertex_buffer(0, g.vb, sizeof(ImDrawVert), 0);
+    rhi_set_index_buffer(g.ib, sizeof(ImDrawIdx) == 2 ? 16 : 32, 0);
+    rhi_set_topology(RHI_TOPOLOGY_TRIANGLES);
+    rhi_set_shader(RHI_STAGE_VERTEX, g.vs);
+    rhi_set_shader(RHI_STAGE_PIXEL, g.ps);
+    rhi_set_uniform_buffers(RHI_STAGE_VERTEX, 7, 1, &g.cb);
+    rhi_set_samplers(8, 1, &g.sampler);
+    rhi_set_blend_state(g.blend, blend_factor, 0xFFFFFFFF);
+    rhi_set_depth_state(g.depth, 0);
+    rhi_set_raster_state(g.raster);
+
+    int vtx_off = 0, idx_off = 0;
+    for (int n = 0; n < dd->CmdListsCount; n++) {
+        const ImDrawList *cl = dd->CmdLists[n];
+        for (int i = 0; i < cl->CmdBuffer.Size; i++) {
+            const ImDrawCmd *pc = &cl->CmdBuffer[i];
+            if (pc->UserCallback) continue;     /* none are used */
+            RhiRect r;
+            r.left = (int32_t)(pc->ClipRect.x > 0 ? pc->ClipRect.x : 0);
+            r.top = (int32_t)(pc->ClipRect.y > 0 ? pc->ClipRect.y : 0);
+            r.right = (int32_t)(pc->ClipRect.z < (float)w ? pc->ClipRect.z : (float)w);
+            r.bottom = (int32_t)(pc->ClipRect.w < (float)h ? pc->ClipRect.w : (float)h);
+            if (r.right <= r.left || r.bottom <= r.top) continue;
+            rhi_set_scissor(&r);
+            RhiView *tex = (RhiView *)(uintptr_t)pc->GetTexID();
+            rhi_set_textures(8, 1, &tex);
+            rhi_draw_indexed(pc->ElemCount, pc->IdxOffset + (uint32_t)idx_off,
+                             (int32_t)pc->VtxOffset + vtx_off);
+        }
+        vtx_off += cl->VtxBuffer.Size;
+        idx_off += cl->IdxBuffer.Size;
+    }
+    /* The title sets its own scissor (or none) with its next draw state;
+     * leave the whole target open for anything drawn after this. */
+    RhiRect all = { 0, 0, (int32_t)w, (int32_t)h };
+    rhi_set_scissor(&all);
+}
+
+} /* namespace */
+
+/* ---- the C side ---------------------------------------------------------- */
+
+extern "C" void d3d8_menu_set(const D3D8Menu *m)
+{
+    std::lock_guard<std::mutex> hold(g_lock);
+    if (m) {
+        g_menu = *m;
+        g_menu_set = true;
+    } else {
+        g_menu_set = false;
+        g_act_count = 0;
+    }
+}
+
+extern "C" int d3d8_menu_take_action(D3D8MenuAction *out)
+{
+    std::lock_guard<std::mutex> hold(g_lock);
+    if (!g_act_count || !out) return 0;
+    *out = g_acts[g_act_head];
+    g_act_head = (g_act_head + 1) % ACT_RING;
+    g_act_count--;
+    return 1;
+}
+
+extern "C" void d3d8_menu_pointer(int x, int y, int in)
+{
+    g_ptr_x = x;
+    g_ptr_y = y;
+    g_ptr_inside = in;
+}
+
+extern "C" void d3d8_menu_pointer_button(int down)
+{
+    if (down && !g_ptr_down) {
+        g_ptr_press_x = g_ptr_x;
+        g_ptr_press_y = g_ptr_y;
+        g_ptr_presses = g_ptr_presses + 1;
+    }
+    g_ptr_down = down;
+}
+
+extern "C" void d3d8_menu_pointer_wheel(int delta)
+{
+    g_wheel = g_wheel + delta;
+}
+
+extern "C" int d3d8_menu_present(RhiView *out, unsigned w, unsigned h,
+                                 unsigned pic_x, unsigned pic_y, unsigned pic_h)
+{
+    D3D8Menu m;
+    {
+        std::lock_guard<std::mutex> hold(g_lock);
+        if (!g_menu_set) {
+            g_seen_presses = g_ptr_presses;     /* a click before it opened is not one in it */
+            return 0;
+        }
+        m = g_menu;
+    }
+    (void)pic_x;
+    if (!out || !w || !h) return 0;
+    if (!gpu_create()) return 0;
+
+    /* One layout unit: the design is 1280x720; the panel stays inside the
+     * window whatever its shape, and follows the picture's height. */
+    float u = (float)(pic_h ? pic_h : h) / 720.0f;
+    if (u * (PANEL_W + 40.0f) > (float)w) u = (float)w / (PANEL_W + 40.0f);
+    if (u * (PANEL_H + 20.0f) > (float)h) u = (float)h / (PANEL_H + 20.0f);
+    if (u < 0.5f) u = 0.5f;
+    ImGui::SetCurrentContext(g.ctx);
+    if (!fonts_for(u)) return 0;
+    U = u;
+
+    ImGuiIO &io = ImGui::GetIO();
+    io.DisplaySize = ImVec2((float)w, (float)h);
+    io.DeltaTime = 1.0f / 60.0f;
+    ImGui::NewFrame();
+    dl = ImGui::GetForegroundDrawList();
+    float px0 = floorf(((float)w - PANEL_W * u) * 0.5f);
+    float pic_cy = pic_h ? (float)pic_y + (float)pic_h * 0.5f : (float)h * 0.5f;
+    float py0 = floorf(pic_cy - PANEL_H * u * 0.5f);
+    if (py0 < 0) py0 = 0;
+    layout_and_draw(m, (float)w, (float)h, px0, py0);
+    ImGui::Render();
+    if (g.failed) return 0;
+
+    RhiOutputState saved;
+    rhi_output_save(&saved);
+    submit(ImGui::GetDrawData(), out, w, h);
+    rhi_output_restore(&saved);
+    return g.failed ? 0 : 1;
+}
+
+extern "C" void d3d8_menu_shutdown(void)
+{
+    font_texture_release();
+    rhi_buffer_destroy(g.vb);  g.vb = NULL; g.vb_cap = 0;
+    rhi_buffer_destroy(g.ib);  g.ib = NULL; g.ib_cap = 0;
+    rhi_buffer_destroy(g.cb);  g.cb = NULL;
+    rhi_vertex_layout_destroy(g.layout); g.layout = NULL;
+    rhi_shader_destroy(g.vs);  g.vs = NULL;
+    rhi_shader_destroy(g.ps);  g.ps = NULL;
+    rhi_sampler_destroy(g.sampler);       g.sampler = NULL;
+    rhi_blend_state_destroy(g.blend);     g.blend = NULL;
+    rhi_depth_state_destroy(g.depth);     g.depth = NULL;
+    rhi_raster_state_destroy(g.raster);   g.raster = NULL;
+    if (g.ctx) {
+        ImGui::DestroyContext(g.ctx);
+        g.ctx = NULL;
+    }
