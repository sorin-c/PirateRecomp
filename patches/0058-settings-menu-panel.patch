+/* What the pointer did over the panel, applied as keys would be. */
+static void take_pointer_actions(void)
+{
+    D3D8MenuAction a;
+
+    while (d3d8_menu_take_action(&a)) {
+        switch (a.kind) {
+        case D3D8_MENU_ACT_TAB:
+            if (a.index >= 0 && a.index < TAB_COUNT && a.index != g_tab)
+                select_tab(a.index);
+            break;
+        case D3D8_MENU_ACT_HOVER:
+            if (is_setting(a.index)) {
+                g_sel = a.index;
+                g_button = -1;
+            }
+            break;
+        case D3D8_MENU_ACT_STEP:
+            if (is_setting(a.index)) {
+                g_sel = a.index;
+                g_button = -1;
+                change(a.step < 0 ? -1 : 1);
+            }
+            break;
+        case D3D8_MENU_ACT_BUTTON:
+            if (a.index == 0)
+                hle_settings_menu_toggle();
+            else if (a.index == 1)
+                quit_game();
+            return;
+        }
+    }
+}
