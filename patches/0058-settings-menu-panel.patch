+/* Vibration strength, 0 to 150 percent of what the title asks for
+ * (`vibration` in the settings file, RECOMP_VIBRATION; 100 by default). Above
+ * 100 makes a weak rumble stronger; a motor never goes past its maximum.
+ * -1: not read yet. */
+static volatile int g_vibration = -1;
+
+static int vibration_percent(void)
+{
+    int v = g_vibration;
+
+    if (v < 0) {
+        v = recomp_config_int("RECOMP_VIBRATION", "vibration", 100);
+        if (v < 0) v = 0;
+        if (v > 150) v = 150;
+        g_vibration = v;
+    }
+    return v;
+}
+
+int recomp_bindings_vibration(void)
+{
+    return vibration_percent();
+}
+
+void recomp_bindings_set_vibration(int percent)
+{
+    if (percent < 0) percent = 0;
+    if (percent > 150) percent = 150;
+    g_vibration = percent;
+}
+
+static unsigned short scale_motor(unsigned short speed, int percent)
+{
+    unsigned long v = (unsigned long)speed * (unsigned long)percent / 100ul;
+    return (unsigned short)(v > 0xFFFFul ? 0xFFFFul : v);
+}
+
 void recomp_bindings_rumble(unsigned port, unsigned short low, unsigned short high)
 {
+    int percent;
+
     if (recomp_headless())
         return;                     /* nobody's pad shakes for a test */
     recomp_bindings_init();
+    percent = vibration_percent();
     if (port < PORTS && g_ctl[port].device == DEV_PAD)
-        recomp_pad_rumble(g_ctl[port].pad, low, high);
+        recomp_pad_rumble(g_ctl[port].pad, scale_motor(low, percent),
+                          scale_motor(high, percent));
 }
