@@ -54,6 +54,88 @@ void d3d8_overlay_set_menu(const char *text);
 void d3d8_overlay_present(RhiView *out, unsigned w, unsigned h,
                           unsigned pic_x, unsigned pic_y, unsigned pic_h);
 
+/* ---- the settings menu, drawn as a panel ----------------------------------
+ *
+ * The in-game settings menu (src/hle/hle_settings_menu.c) hands its whole
+ * state over as one D3D8Menu: tabs, rows, the selection, the description of
+ * the selected row. d3d8_menu.cpp draws it with Dear ImGui at the window's
+ * own resolution, over the picture. What the menu means stays in src/hle;
+ * this side only lays it out, draws it, and reports what the pointer did
+ * (d3d8_menu_take_action), which the menu then applies as it would a key. */
+#define D3D8_MENU_MAX_TABS  6
+#define D3D8_MENU_MAX_ROWS 24
+
+enum {
+    D3D8_MENU_ROW_GROUP = 0,      /* a heading over the rows after it */
+    D3D8_MENU_ROW_SETTING,        /* a value with arrows: the selectable kind */
+    D3D8_MENU_ROW_INFO            /* a label and a value, nothing to change */
+};
+enum {
+    D3D8_MENU_TAG_NOW          = 1,   /* applies at once */
+    D3D8_MENU_TAG_RESTART      = 2,   /* applies at the next start */
+    D3D8_MENU_TAG_EXPERIMENTAL = 4,
+    D3D8_MENU_TAG_CHANGED      = 8,   /* not the default */
+    D3D8_MENU_TAG_ENV          = 16   /* an environment variable overrides it */
+};
+
+typedef struct {
+    int  kind;                    /* D3D8_MENU_ROW_* */
+    int  tags;                    /* D3D8_MENU_TAG_* */
+    int  index, count, def;       /* the value's place among count, the default's */
+    char label[48];
+    char value[40];
+} D3D8MenuRow;
+
+typedef struct {
+    int  tab_count, tab;
+    char tabs[D3D8_MENU_MAX_TABS][20];
+    int  row_count;
+    D3D8MenuRow rows[D3D8_MENU_MAX_ROWS];
+    int  sel;                     /* a row, or -1 */
+    int  button;                  /* -1, or the focused footer button: 0 Resume, 1 Quit */
+    unsigned serial;              /* bumped when sel/tab moved by a key: scroll to it */
+    char title[24];
+    char subtitle[96];
+    char info_title[48];
+    char info_text[400];
+    char info_default[40];
+    char info_when[48];
+    char info_options[160];
+    char status[96];              /* e.g. "2 changes apply at the next start" */
+    char warning[112];            /* e.g. the settings file could not be written */
+} D3D8Menu;
+
+/* The menu to draw from now on, copied; NULL hides it. Any thread. */
+void d3d8_menu_set(const D3D8Menu *m);
+
+/* What the pointer did over the panel, oldest first; 1 while there was one.
+ * Read by the menu on its own thread. */
+enum {
+    D3D8_MENU_ACT_NONE = 0,
+    D3D8_MENU_ACT_TAB,            /* index: the tab clicked */
+    D3D8_MENU_ACT_HOVER,          /* index: the row the pointer moved onto */
+    D3D8_MENU_ACT_STEP,           /* index: the row; step: -1 or 1 (a click on it or its arrows) */
+    D3D8_MENU_ACT_BUTTON          /* index: 0 Resume, 1 Quit */
+};
+typedef struct { int kind, index, step; } D3D8MenuAction;
+int d3d8_menu_take_action(D3D8MenuAction *out);
+
+/* The pointer, from the window's own thread: its position in client pixels
+ * (inside 0 when it left the window), the left button, and the wheel (in
+ * WHEEL_DELTA units, 120 a notch, positive away from the user). */
+void d3d8_menu_pointer(int x, int y, int inside);
+void d3d8_menu_pointer_button(int down);
+void d3d8_menu_pointer_wheel(int delta);
+
+/* Draws the menu, when one is set, over `out` (w x h pixels; the picture at
+ * pic_x, pic_y, pic_h tall). 0 when it could not (nothing set, or the
+ * renderer for it failed to start), and the caller falls back to the text
+ * panel. Saves and restores the output state as d3d8_overlay_present does,
+ * and binds its own sampler on slot 8. */
+int  d3d8_menu_present(RhiView *out, unsigned w, unsigned h,
+                       unsigned pic_x, unsigned pic_y, unsigned pic_h);
+void d3d8_menu_shutdown(void);
+
 /* Releases everything. Called from the device teardown. */
 void d3d8_overlay_shutdown(void);
 
